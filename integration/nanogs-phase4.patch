+void FGaussianSplatRenderer::DispatchStreamedUploads(FRHICommandListImmediate& RHICmdList, FGaussianSplatRenderData& Data)
+{
+	FGaussianStreamedResidency* Residency = Data.Residency.Get();
+	if (!Residency || Residency->GetUploads().IsEmpty() || !Data.SOGRecordBufferUAV.IsValid()
+		|| !Data.ClusterBufferUAV.IsValid() || !Data.SplatClusterIndexBufferUAV.IsValid())
+	{
+		return;
+	}
+	SCOPED_DRAW_EVENT(RHICmdList, GaussianSplatStreamedUploads);
+	FGaussianStreamedResidency::FUploads& Uploads = Residency->GetUploads();
+
+	RHICmdList.Transition({
+		FRHITransitionInfo(Data.SOGRecordBuffer, ERHIAccess::SRVMask, ERHIAccess::UAVCompute),
+		FRHITransitionInfo(Data.SplatClusterIndexBuffer, ERHIAccess::SRVMask, ERHIAccess::UAVCompute),
+		FRHITransitionInfo(Data.ClusterBuffer, ERHIAccess::SRVMask, ERHIAccess::UAVCompute) });
+
+	if (Uploads.Blocks.Num() > 0)
+	{
+		FBufferRHIRef RecordsBuffer, BlocksBuffer;
+		TShaderMapRef<FStreamedUploadBlocksCS> Shader(GetGlobalShaderMap(GMaxRHIFeatureLevel));
+		FStreamedUploadBlocksCS::FParameters Parameters;
+		Parameters.UploadRecords = MakeUploadBuffer(RHICmdList, TEXT("GaussianStreamedUploadRecords"), Uploads.Records.GetData(),
+			uint32(Uploads.Records.Num()), 0, RecordsBuffer);
+		Parameters.UploadBlocks = MakeUploadBuffer(RHICmdList, TEXT("GaussianStreamedUploadBlocks"), Uploads.Blocks.GetData(),
+			uint32(Uploads.Blocks.Num()) * sizeof(FUintVector4), sizeof(FUintVector4), BlocksBuffer);
+		Parameters.RecordPool = Data.SOGRecordBufferUAV;
+		Parameters.PoolClusterIndex = Data.SplatClusterIndexBufferUAV;
+		Parameters.DummyCluster = Data.DummyCluster;
+		SetComputePipelineState(RHICmdList, Shader.GetComputeShader());
+		SetShaderParameters(RHICmdList, Shader, Shader.GetComputeShader(), Parameters);
+		RHICmdList.DispatchComputeShader(uint32(Uploads.Blocks.Num()), 1, 1);
+		UnsetShaderUAVs(RHICmdList, Shader, Shader.GetComputeShader());
+	}
+	if (Uploads.Clusters.Num() > 0)
+	{
+		FBufferRHIRef UpdatesBuffer;
+		TShaderMapRef<FStreamedUpdateClustersCS> Shader(GetGlobalShaderMap(GMaxRHIFeatureLevel));
+		FStreamedUpdateClustersCS::FParameters Parameters;
+		Parameters.ClusterUpdates = MakeUploadBuffer(RHICmdList, TEXT("GaussianStreamedClusterUpdates"), Uploads.Clusters.GetData(),
+			uint32(Uploads.Clusters.Num()) * sizeof(FUintVector4), sizeof(FUintVector4), UpdatesBuffer);
+		Parameters.ClusterBufferRW = Data.ClusterBufferUAV;
+		Parameters.NumClusterUpdates = uint32(Uploads.Clusters.Num());
+		SetComputePipelineState(RHICmdList, Shader.GetComputeShader());
+		SetShaderParameters(RHICmdList, Shader, Shader.GetComputeShader(), Parameters);
+		RHICmdList.DispatchComputeShader(FMath::DivideAndRoundUp(uint32(Uploads.Clusters.Num()), 64u), 1, 1);
+		UnsetShaderUAVs(RHICmdList, Shader, Shader.GetComputeShader());
+	}
+
+	RHICmdList.Transition({
+		FRHITransitionInfo(Data.SOGRecordBuffer, ERHIAccess::UAVCompute, ERHIAccess::SRVMask),
+		FRHITransitionInfo(Data.SplatClusterIndexBuffer, ERHIAccess::UAVCompute, ERHIAccess::SRVMask),
+		FRHITransitionInfo(Data.ClusterBuffer, ERHIAccess::UAVCompute, ERHIAccess::SRVMask) });
+	Uploads.Reset();
 }
 
