+	/** Axis-aligned bounds of a file-frame box after SOG's file -> local transform (column-major 4x4). */
+	void FileBoundsToLocal(const float Min[3], const float Max[3], const float M[16], FVector3f& OutMin, FVector3f& OutMax)
+	{
+		OutMin = FVector3f(MAX_flt);
+		OutMax = FVector3f(-MAX_flt);
+		for (int32 Corner = 0; Corner < 8; ++Corner)
+		{
+			const float P[3] = { (Corner & 1) ? Max[0] : Min[0], (Corner & 2) ? Max[1] : Min[1], (Corner & 4) ? Max[2] : Min[2] };
+			const FVector3f L(
+				M[0] * P[0] + M[4] * P[1] + M[8] * P[2] + M[12],
+				M[1] * P[0] + M[5] * P[1] + M[9] * P[2] + M[13],
+				M[2] * P[0] + M[6] * P[1] + M[10] * P[2] + M[14]);
+			OutMin = OutMin.ComponentMin(L);
+			OutMax = OutMax.ComponentMax(L);
+		}
+	}
