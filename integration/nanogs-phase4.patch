+void UGaussianSplatAsset::BeginDestroy()
+{
+	Super::BeginDestroy();
+	DetachRenderDataStreaming(false);
+}
+
+bool UGaussianSplatAsset::IsReadyForFinishDestroy()
+{
+	// Streaming reads of SOGRecordBulkData must have stopped before it's freed
+	return Super::IsReadyForFinishDestroy() && StreamingDetachFence.IsFenceComplete();
+}
+
+void UGaussianSplatAsset::DetachRenderDataStreaming(bool bWait)
+{
+	if (RenderData.IsValid() && RenderData->Residency.IsValid())
+	{
+		TSharedPtr<FGaussianSplatRenderData> Data = RenderData;
+		ENQUEUE_RENDER_COMMAND(NanoGSDetachStreaming)([Data](FRHICommandListImmediate&)
+		{
+			Data->DetachStreaming();
+		});
+		StreamingDetachFence.BeginFence();
+		if (bWait)
+		{
+			StreamingDetachFence.Wait();
+		}
+	}
+}
+
+bool UGaussianSplatAsset::ReadSOGRecords(uint32 First, uint32 Count, TArray<uint8>& OutData) const
+{
+	const uint64 Offset = uint64(First) * sizeof(sog::PackedSplat);
+	const uint64 Bytes = uint64(Count) * sizeof(sog::PackedSplat);
+	if (Offset + Bytes > uint64(SOGRecordBulkData.GetBulkDataSize()))
+	{
+		return false;
+	}
+	OutData.SetNumUninitialized(int64(Bytes));
+	if (Bytes == 0)
+	{
+		return true;
+	}
+	if (SOGRecordBulkData.IsBulkDataLoaded())
+	{
+		const uint8* Data = static_cast<const uint8*>(SOGRecordBulkData.LockReadOnly());
+		FMemory::Memcpy(OutData.GetData(), Data + Offset, Bytes);
+		SOGRecordBulkData.Unlock();
+		return true;
+	}
+	FIoBuffer Buffer(FIoBuffer::Wrap, OutData.GetData(), Bytes);
+	FBulkDataBatchRequest Request;
+	FBulkDataBatchRequest::NewBatch(1).Read(SOGRecordBulkData, Offset, Bytes, AIOP_CriticalPath, Buffer).Issue(Request);
+	Request.Wait();
+	return Request.IsOk();
+}
