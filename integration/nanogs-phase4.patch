@@ -0,0 +1,354 @@
+// Copyright Epic Games, Inc. All Rights Reserved.
+
+#include "GaussianSplatStreaming.h"
+#include "HAL/IConsoleManager.h"
+
+static TAutoConsoleVariable<int32> CVarGSStreamingMaxReads(
+	TEXT("gs.StreamingMaxReads"),
+	32,
+	TEXT("Streamed SOG: most page reads in flight per asset."),
+	ECVF_RenderThreadSafe);
+
+static TAutoConsoleVariable<int32> CVarGSStreamingMaxUploads(
+	TEXT("gs.StreamingMaxUploadsPerFrame"),
+	16,
+	TEXT("Streamed SOG: most pages moved into the pool per asset and frame (bounds the upload cost of a frame)."),
+	ECVF_RenderThreadSafe);
+
+FGaussianStreamedResidency::~FGaussianStreamedResidency()
+{
+	Detach();
+}
+
+void FGaussianStreamedResidency::Initialize(const FGaussianStreamedLOD& InLOD, const TArray<FGaussianGPUCluster>& AssetClusters,
+	uint32 PoolSplats, const FByteBulkData* InSource)
+{
+	LOD = &InLOD;
+	Source = InSource;
+	Clusters = AssetClusters;
+	NumLevels = InLOD.NumLevels;
+	const int32 Pinned = NumLevels - 1;
+	PinnedRecords = InLOD.LevelSplatCounts.IsValidIndex(Pinned) ? uint32(InLOD.LevelSplatCounts[Pinned]) : 0u;
+	DynamicBase = Align(PinnedRecords, BlockRecords);
+	NumBlocks = PoolSplats / BlockRecords;
+	PoolRecords = DynamicBase + NumBlocks * BlockRecords;
+
+	// One page per (node, finer level) run; pages hold read handles, so the array is sized once
+	int32 NumPages = 0;
+	for (const FGaussianStreamedLODNode& Node : InLOD.Nodes)
+	{
+		for (int32 L = 0; L < Pinned; ++L)
+		{
+			NumPages += (Node.SplatCounts[L] > 0 && Node.ClusterCounts[L] > 0) ? 1 : 0;
+		}
+	}
+	Pages.SetNum(NumPages);
+	PageIndex.Init(INDEX_NONE, InLOD.Nodes.Num() * NumLevels);
+	uint32 LargestPage = 0;
+	int32 P = 0;
+	for (int32 N = 0; N < InLOD.Nodes.Num(); ++N)
+	{
+		const FGaussianStreamedLODNode& Node = InLOD.Nodes[N];
+		for (int32 L = 0; L < Pinned; ++L)
+		{
+			if (Node.SplatCounts[L] == 0 || Node.ClusterCounts[L] == 0)
+			{
+				continue;
+			}
+			FPage& Page = Pages[P];
+			Page.Node = uint32(N);
+			Page.Level = uint32(L);
+			Page.FirstCluster = Node.FirstCluster[L];
+			Page.NumClusters = Node.ClusterCounts[L];
+			Page.RecordStart = Clusters[int32(Page.FirstCluster)].SplatStartIndex;   // a run's records are contiguous
+			Page.RecordCount = Node.SplatCounts[L];
+			LargestPage = FMath::Max(LargestPage, Page.NumClusters);
+			PageIndex[N * NumLevels + L] = P++;
+		}
+	}
+
+	FreeBlocks.Reset(NumBlocks);
+	for (uint32 B = NumBlocks; B-- > 0;)
+	{
+		FreeBlocks.Add(B);                            // popped from the back: lowest blocks first
+	}
+	FreedThisUpdate.Init(false, int32(NumBlocks));
+	bActive = Source != nullptr && NumBlocks > 0 && Pages.Num() > 0;
+	if (bActive && LargestPage > NumBlocks)
+	{
+		UE_LOG(LogTemp, Warning, TEXT("Streamed SOG: the largest page needs %u blocks but the pool has %u (gs.StreamingPoolSplats); those levels will never load"),
+			LargestPage, NumBlocks);
+	}
+}
+
+void FGaussianStreamedResidency::MakeInitialGPUState(TArray<FGaussianGPUCluster>& InOutClusters, TArray<uint32>& OutPoolClusters,
+	uint32 Dummy) const
+{
+	OutPoolClusters.Init(Dummy, int32(PoolRecords));
+	for (int32 C = 0; C < InOutClusters.Num(); ++C)
+	{
+		FGaussianGPUCluster& Cluster = InOutClusters[C];
+		if (Cluster.LODLevel == uint32(NumLevels - 1))
+		{
+			// The coarsest level stays where the asset has it: the start of the pool
+			for (uint32 I = 0; I < Cluster.SplatCount; ++I)
+			{
+				OutPoolClusters[int32(Cluster.SplatStartIndex + I)] = uint32(C);
+			}
+		}
+		else
+		{
+			Cluster.SplatStartIndex = 0;
+			Cluster.SplatCount = 0;                   // not resident: culling skips it
+		}
+	}
+}
+
+uint32 FGaussianStreamedResidency::Resolve(uint32 Node, uint32 Desired, uint64 Frame)
+{
+	const FGaussianStreamedLODNode& N = LOD->Nodes[int32(Node)];
+	for (int32 L = int32(Desired); L < NumLevels; ++L)
+	{
+		if (N.SplatCounts[L] == 0)
+		{
+			continue;
+		}
+		if (L == NumLevels - 1)
+		{
+			return uint32(L);
+		}
+		const int32 P = PageOf(Node, uint32(L));
+		if (P != INDEX_NONE && Pages[P].State == EPageState::Resident)
+		{
+			Pages[P].LastUsed = Frame;
+			return uint32(L);
+		}
+	}
+	return MAX_uint32;
+}
+
+void FGaussianStreamedResidency::Request(uint32 Node, uint32 Desired, float Priority)
+{
+	if (!bActive || int32(Desired) >= NumLevels - 1)
+	{
+		return;
+	}
+	const int32 P = PageOf(Node, Desired);
+	if (P == INDEX_NONE)
+	{
+		return;
+	}
+	FPage& Page = Pages[P];
+	if (Page.State == EPageState::Absent)
+	{
+		Page.State = EPageState::Requested;
+		Page.Priority = Priority;
+		Requested.Add(P);
+	}
+	else if (Page.State == EPageState::Requested)
+	{
+		Page.Priority = FMath::Max(Page.Priority, Priority);
+	}
+}
+
+bool FGaussianStreamedResidency::Allocate(FPage& Page, uint64 Frame, uint32 DummyCluster)
+{
+	while (uint32(FreeBlocks.Num()) < Page.NumClusters)
+	{
+		// Evict the least recently used resident page that no view has used this frame
+		FPage* Victim = nullptr;
+		for (FPage& Other : Pages)
+		{
+			if (Other.State == EPageState::Resident && Other.LastUsed < Frame && (!Victim || Other.LastUsed < Victim->LastUsed))
+			{
+				Victim = &Other;
+			}
+		}
+		if (!Victim)
+		{
+			return false;
+		}
+		Evict(*Victim);
+	}
+	Page.Blocks.Reset(int32(Page.NumClusters));
+	for (uint32 K = 0; K < Page.NumClusters; ++K)
+	{
+		const uint32 Block = FreeBlocks.Pop(EAllowShrinking::No);
+		FreedThisUpdate[int32(Block)] = false;        // reused: the upload rewrites its positions
+		Page.Blocks.Add(Block);
+	}
+	return true;
+}
+
+void FGaussianStreamedResidency::Evict(FPage& Page)
+{
+	for (uint32 K = 0; K < Page.NumClusters; ++K)
+	{
+		Uploads.Clusters.Add(FUintVector4(Page.FirstCluster + K, 0, 0, 0));
+	}
+	for (uint32 Block : Page.Blocks)
+	{
+		FreeBlocks.Add(Block);
+		FreedThisUpdate[int32(Block)] = true;
+		FreedList.Add(Block);
+	}
+	Page.Blocks.Reset();
+	Page.State = EPageState::Absent;
+	++Evictions;
+}
+
+bool FGaussianStreamedResidency::Update(uint64 Frame, uint32 DummyCluster)
+{
+	bool bChanged = false;
+	FreedList.Reset();
+
+	// Finished reads go into the pool
+	const int32 MaxUploads = FMath::Max(1, CVarGSStreamingMaxUploads.GetValueOnRenderThread());
+	int32 Uploaded = 0;
+	for (int32 I = 0; I < Loading.Num();)
+	{
+		FPage& Page = Pages[Loading[I]];
+		if (!Page.Read.IsCompleted() || Uploaded >= MaxUploads)
+		{
+			++I;
+			continue;
+		}
+		const bool bOk = Page.Read.IsOk() && Page.Data.GetSize() >= uint64(Page.RecordCount) * RecordBytes;
+		Page.Read.Reset();
+		Loading.RemoveAtSwap(I, EAllowShrinking::No);
+		if (!bOk)
+		{
+			if (Failures++ == 0)
+			{
+				UE_LOG(LogTemp, Warning, TEXT("Streamed SOG: a page read failed (node %u, level %u); the node keeps a coarser level"), Page.Node, Page.Level);
+			}
+			Page.State = EPageState::Absent;
+			Page.Data = FIoBuffer();
+			continue;
+		}
+		if (!Allocate(Page, Frame, DummyCluster))
+		{
+			Page.State = EPageState::Absent;              // everything resident is in use this frame; asked again later
+			Page.Data = FIoBuffer();
+			continue;
+		}
+		const uint8* Data = Page.Data.GetData();
+		for (uint32 K = 0; K < Page.NumClusters; ++K)
+		{
+			const uint32 C = Page.FirstCluster + K;
+			const FGaussianGPUCluster& Cluster = Clusters[int32(C)];
+			const uint32 Block = Page.Blocks[int32(K)];
+			const uint32 SourceBlock = uint32(Uploads.Records.Num()) / (BlockRecords * RecordBytes);
+			const int32 At = Uploads.Records.AddZeroed(BlockRecords * RecordBytes);
+			FMemory::Memcpy(&Uploads.Records[At], Data + uint64(Cluster.SplatStartIndex - Page.RecordStart) * RecordBytes,
+				Cluster.SplatCount * RecordBytes);
+			Uploads.Blocks.Add(FUintVector4(BlockRecord(Block), C, Cluster.SplatCount, SourceBlock));
+			Uploads.Clusters.Add(FUintVector4(C, BlockRecord(Block), Cluster.SplatCount, 0));
+		}
+		Page.Data = FIoBuffer();
+		Page.State = EPageState::Resident;
+		Page.LastUsed = Frame;
+		++Loads;
+		++Uploaded;
+		bChanged = true;
+	}
+
+	// Blocks freed by evictions and not reused: their pool positions point at the dummy cluster again
+	for (uint32 Block : FreedList)
+	{
+		if (FreedThisUpdate[int32(Block)])
+		{
+			Uploads.Blocks.Add(FUintVector4(BlockRecord(Block), DummyCluster, 0, 0));
+			FreedThisUpdate[int32(Block)] = false;
+		}
+	}
+	bChanged = bChanged || FreedList.Num() > 0;
+
+	// Issue the requested reads, largest priority first; the rest are asked for again by later frames. Only as many as
+	// the pool can take: free blocks plus pages no view drew this frame, less what the reads in flight will need
+	// (otherwise a view that wants more than the pool holds would re-read pages it can never place, every frame).
+	if (bActive && Requested.Num() > 0)
+	{
+		int64 Room = FreeBlocks.Num();
+		for (const FPage& Page : Pages)
+		{
+			Room += (Page.State == EPageState::Resident && Page.LastUsed < Frame) ? int64(Page.NumClusters) : 0;
+		}
+		for (int32 P : Loading)
+		{
+			Room -= int64(Pages[P].NumClusters);
+		}
+		Requested.Sort([this](int32 A, int32 B) { return Pages[A].Priority > Pages[B].Priority; });
+		const int32 MaxReads = FMath::Max(1, CVarGSStreamingMaxReads.GetValueOnRenderThread());
+		for (int32 P : Requested)
+		{
+			FPage& Page = Pages[P];
+			if (Page.State != EPageState::Requested)
+			{
+				continue;
+			}
+			if (Loading.Num() >= MaxReads || int64(Page.NumClusters) > Room)
+			{
+				Page.State = EPageState::Absent;
+				continue;
+			}
+			Room -= int64(Page.NumClusters);
+			FBulkDataBatchRequest::NewBatch(1)
+				.Read(*Source, uint64(Page.RecordStart) * RecordBytes, uint64(Page.RecordCount) * RecordBytes, AIOP_Normal, Page.Data)
+				.Issue(Page.Read);
+			Page.State = EPageState::Loading;
+			Loading.Add(P);
+		}
+	}
+	for (int32 P : Requested)
+	{
+		if (Pages[P].State == EPageState::Requested)
+		{
+			Pages[P].State = EPageState::Absent;
+		}
+	}
+	Requested.Reset();
+
+	if (bChanged)
+	{
+		++Generation;
+	}
+	return bChanged;
+}
+
+void FGaussianStreamedResidency::Detach()
+{
+	bActive = false;
+	for (int32 P : Loading)
+	{
+		FPage& Page = Pages[P];
+		Page.Read.Cancel();
+		Page.Read.Reset();                            // waits for the read to finish
+		Page.Data = FIoBuffer();
+		Page.State = EPageState::Absent;
+	}
+	Loading.Reset();
+	for (int32 P : Requested)
+	{
+		Pages[P].State = EPageState::Absent;
+	}
+	Requested.Reset();
+	Source = nullptr;
+}
+
+FGaussianStreamedResidency::FStats FGaussianStreamedResidency::GetStats() const
+{
+	FStats Stats;
+	Stats.TotalPages = Pages.Num();
+	Stats.TotalBlocks = int32(NumBlocks);
+	Stats.UsedBlocks = int32(NumBlocks) - FreeBlocks.Num();
+	for (const FPage& Page : Pages)
+	{
+		Stats.ResidentPages += Page.State == EPageState::Resident ? 1 : 0;
+		Stats.LoadingPages += Page.State == EPageState::Loading ? 1 : 0;
+	}
+	Stats.Loads = Loads;
+	Stats.Evictions = Evictions;
+	Stats.Failures = Failures;
+	return Stats;
+}
