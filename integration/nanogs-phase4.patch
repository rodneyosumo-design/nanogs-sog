+void UGaussianSplatAsset::InitializeFromStreamedSOG(const TArray<FGaussianSplatData>& PreviewSplats,
+	const sog::DecodedAsset& Source, const TArray<FStreamedClusterDesc>& Clusters, FGaussianStreamedLOD&& LOD,
+	EGaussianQualityLevel InQuality)
+{
+	check(Source.splats.size() == Source.count && Clusters.Num() > 0 && LOD.IsValid());
+	SplatCount = int32(Source.count);
+	OriginalSplatCount = SplatCount;          // no NanoGS LOD splats: every record belongs to a streamed level
+	ImportQuality = InQuality;
+	SHBands = int32(Source.shBands);
+
+	// Every cluster is a leaf of its (node, level) run; the level goes in LODLevel, the node in the LOD table
+	FGaussianClusterHierarchy Hierarchy;
+	Hierarchy.Clusters.SetNum(Clusters.Num());
+	BoundingBox.Init();
+	for (int32 Index = 0; Index < Clusters.Num(); ++Index)
+	{
+		const FStreamedClusterDesc& Desc = Clusters[Index];
+		FGaussianCluster& Cluster = Hierarchy.Clusters[Index];
+		Cluster.ClusterID = uint32(Index);
+		Cluster.LODLevel = Desc.Level;
+		Cluster.BoundsMin = Desc.BoundsMin;
+		Cluster.BoundsMax = Desc.BoundsMax;
+		Cluster.ComputeBoundingSphereFromAABB();
+		Cluster.SplatStartIndex = Desc.SplatStart;
+		Cluster.SplatCount = Desc.SplatCount;
+		BoundingBox += FBox(FVector(Desc.BoundsMin), FVector(Desc.BoundsMax));
+	}
+	Hierarchy.NumLODLevels = uint32(LOD.NumLevels);
+	Hierarchy.SplatsPerCluster = GaussianClusterConstants::DefaultSplatsPerCluster;
+	Hierarchy.RootClusterIndex = 0;
+	Hierarchy.NumLeafClusters = uint32(Clusters.Num());
+	Hierarchy.TotalSplatCount = uint32(SplatCount);
+	ClusterHierarchy = MoveTemp(Hierarchy);
+
+	ClearNanoGSSplatData();
+	SetSOGData(Source, TArray<sog::PackedSplat>(Source.splats.data(), int32(Source.splats.size())));
+	StreamedLOD = MoveTemp(LOD);
+	bHasStreamedLOD = true;
+	StreamedLODLevels = StreamedLOD.NumLevels;
+	StreamedLODNodes = StreamedLOD.Nodes.Num();
+	bEnableNanite = true;                     // the renderer's cluster culling + compaction path
+	GenerateThumbnail(PreviewSplats);
+	RenderData.Reset();
+
+	UE_LOG(LogTemp, Log, TEXT("GaussianSplatAsset: Initialized Streamed SOG: %d splats in %d levels, %d nodes, %d clusters (records %lld bytes, palette %lld bytes)"),
+		SplatCount, StreamedLODLevels, StreamedLODNodes, ClusterHierarchy.Clusters.Num(), GetSOGRecordDataSize(), GetSOGPaletteDataSize());
+}
