+/**
+ * Streamed SOG LOD, imported from a lod-meta.json. Each leaf of its tree is a node: one region of the scene with
+ * up to NumLevels alternative representations (level 0 finest). Every (node, level) run of splats is split into
+ * clusters of up to 128 splats, stored in the cluster hierarchy as leaf clusters whose LODLevel is the level.
+ * Records are ordered coarsest level first, so the coarsest level is a prefix of the splat buffer. Each frame
+ * the renderer picks one level per node on the CPU and the culling pass keeps only that level's clusters.
+ */
+struct FGaussianStreamedLODNode
+{
+	/** Node bounds from lod-meta.json, in local space (cm) */
+	FVector3f BoundsMin = FVector3f::ZeroVector;
+	FVector3f BoundsMax = FVector3f::ZeroVector;
+
+	/** Per level: relative image error against the finest level (splat-transform --lod-errors), non-decreasing */
+	TArray<float> Errors;
+
+	/** Per level: splats, and the node's clusters [FirstCluster, FirstCluster + ClusterCounts) */
+	TArray<uint32> SplatCounts;
+	TArray<uint32> FirstCluster;
+	TArray<uint32> ClusterCounts;
+
+	friend FArchive& operator<<(FArchive& Ar, FGaussianStreamedLODNode& Node)
+	{
+		Ar << Node.BoundsMin;
+		Ar << Node.BoundsMax;
+		Ar << Node.Errors;
+		Ar << Node.SplatCounts;
+		Ar << Node.FirstCluster;
+		Ar << Node.ClusterCounts;
+		return Ar;
+	}
+};
+
+struct FGaussianStreamedLOD
+{
+	int32 NumLevels = 0;
+
+	/** True when the errors come from the file; false when derived from splat counts (log(finest / count)) */
+	bool bErrorsFromFile = false;
+
+	TArray<FGaussianStreamedLODNode> Nodes;
+
+	/** Splats per level over all nodes */
+	TArray<uint64> LevelSplatCounts;
+
+	bool IsValid() const { return NumLevels > 0 && Nodes.Num() > 0; }
+
+	/** Most splats one frame can select: every node at its largest level */
+	uint32 GetMaxSelectableSplats() const
+	{
+		uint64 Total = 0;
+		for (const FGaussianStreamedLODNode& Node : Nodes)
+		{
+			uint32 Largest = 0;
+			for (uint32 Count : Node.SplatCounts)
+			{
+				Largest = FMath::Max(Largest, Count);
+			}
+			Total += Largest;
+		}
+		return uint32(FMath::Min<uint64>(Total, MAX_uint32));
+	}
+
+	void Reset()
+	{
+		NumLevels = 0;
+		bErrorsFromFile = false;
+		Nodes.Empty();
+		LevelSplatCounts.Empty();
+	}
+
+	friend FArchive& operator<<(FArchive& Ar, FGaussianStreamedLOD& LOD)
+	{
+		Ar << LOD.NumLevels;
+		Ar << LOD.bErrorsFromFile;
+		Ar << LOD.Nodes;
+		Ar << LOD.LevelSplatCounts;
 		return Ar;
 	}
 };
