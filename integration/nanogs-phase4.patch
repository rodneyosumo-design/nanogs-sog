+/** Debug: log the Streamed SOG level choice. */
+TAutoConsoleVariable<int32> CVarGSStreamedLODStats(
+	TEXT("gs.StreamedLODStats"),
+	0,
+	TEXT("Debug: 1 = log the Streamed SOG LOD choice (visible nodes and splats per level) about once a second."),
+	ECVF_RenderThreadSafe);
+
+/** One Streamed SOG proxy's level choice for a view. */
+struct FStreamedLODChoice
+{
+	FGaussianSplatGPUResources* Resources = nullptr;
+	const FGaussianStreamedLOD* LOD = nullptr;
+	FMatrix LocalToWorld = FMatrix::Identity;
+	float Threshold = 0.0f;
+	TArray<uint32> Levels;            // per node; MAX_uint32 = not drawn
+	TArray<float> Coverage;           // per node: f^2 (0 = outside the frustum); streaming priority
+	uint64 Selected = 0;              // splats in the chosen levels
+};
+
+/**
+ * The streamed threshold rule is looser than NanoGS's own LOD metric at the same value: in the campus quad view,
+ * Errors[l] * f^2 <= (2T)^2 costs about what NanoGS's LOD costs at T (both at the component default, 0.03).
+ */
+static constexpr double GStreamedThresholdScale = 2.0;
+
+/**
+ * Streamed SOG LOD: choose one level per lod-meta.json node for this view.
+ *  - Coverage: a node of radius r at distance d covers f = r / (r + d * tan(fov/2)) of the half-screen (1 when the
+ *    camera is inside it).
+ *  - Budget (bBudget, PlayCanvas's approach): every visible node starts at its coarsest level and is refined, largest
+ *    coverage-weighted error reduction per added splat first, until the chosen splats fill Budget.
+ *  - No budget: a node takes its coarsest level whose error, a relative image error, is within the LOD error threshold
+ *    at that coverage: Errors[l] * f^2 <= T^2.
+ *  Nodes outside the frustum draw nothing. ForceLevel >= 0 (gs.DebugForceLODLevel) picks that level everywhere.
+ */
+static void ChooseStreamedLevels(const FSceneView& View, TArray<FStreamedLODChoice>& Choices, bool bBudget, uint64 Budget,
+	int32 ForceLevel)
+{
+	const FMatrix& Proj = View.ViewMatrices.GetViewToClip();
+	const bool bPerspective = View.IsPerspectiveProjection();
+	const double ProjScale = FMath::Max(Proj.M[0][0], Proj.M[1][1]);   // 1 / tan(fov/2); orthographic: 1 / half-height
+	const FVector CameraPos = View.ViewMatrices.GetViewOrigin();
+	bBudget = bBudget && ForceLevel < 0;
+
+	TArray<TArray<float>> Coverage;
+	TArray<TArray<uint32>> Targets;
+	Coverage.SetNum(Choices.Num());
+	Targets.SetNum(Choices.Num());
+	uint64 Spent = 0;
+
+	for (int32 C = 0; C < Choices.Num(); ++C)
+	{
+		FStreamedLODChoice& Choice = Choices[C];
+		const FGaussianStreamedLOD& LOD = *Choice.LOD;
+		const int32 NumNodes = LOD.Nodes.Num();
+		Choice.Levels.Init(MAX_uint32, NumNodes);
+		Coverage[C].Init(0.0f, NumNodes);
+		Targets[C].Init(MAX_uint32, NumNodes);
+		const double Scale = Choice.LocalToWorld.GetMaximumAxisScale();
+		const double Threshold = GStreamedThresholdScale * double(Choice.Threshold);
+		const double Threshold2 = Threshold * Threshold;
+		for (int32 N = 0; N < NumNodes; ++N)
+		{
+			const FGaussianStreamedLODNode& Node = LOD.Nodes[N];
+			int32 Finest = INDEX_NONE;
+			int32 Coarsest = INDEX_NONE;
+			for (int32 L = 0; L < LOD.NumLevels; ++L)
+			{
+				if (Node.SplatCounts[L] > 0)
+				{
+					Finest = Finest == INDEX_NONE ? L : Finest;
+					Coarsest = L;
+				}
+			}
+			const FVector Center = Choice.LocalToWorld.TransformPosition(FVector((Node.BoundsMin + Node.BoundsMax) * 0.5f));
+			const double Radius = 0.5 * FVector(Node.BoundsMax - Node.BoundsMin).Size() * Scale;
+			if (Finest == INDEX_NONE || !View.ViewFrustum.IntersectSphere(Center, Radius))
+			{
+				continue;
+			}
+			double F = 1.0;
+			if (bPerspective)
+			{
+				const double Distance = FMath::Max(0.0, FVector::Dist(Center, CameraPos) - Radius);
+				F = Radius / FMath::Max(Radius + Distance / ProjScale, UE_SMALL_NUMBER);
+			}
+			else
+			{
+				F = FMath::Min(1.0, Radius * ProjScale);
+			}
+			const double F2 = F * F;
+			Coverage[C][N] = float(F2);
+
+			int32 Level = Finest;
+			if (ForceLevel >= 0)
+			{
+				Level = Coarsest;
+				for (int32 L = FMath::Min(ForceLevel, LOD.NumLevels - 1); L <= Coarsest; ++L)
+				{
+					if (Node.SplatCounts[L] > 0)
+					{
+						Level = L;
+						break;
+					}
+				}
+			}
+			else
+			{
+				for (int32 L = Coarsest; L > Finest; --L)
+				{
+					if (Node.SplatCounts[L] > 0 && double(Node.Errors[L]) * F2 <= Threshold2)
+					{
+						Level = L;
+						break;
+					}
+				}
+			}
+			// With a budget the refinement may go all the way to the finest level; the threshold applies without one
+			Targets[C][N] = uint32(bBudget ? Finest : Level);
+			Choice.Levels[N] = uint32(bBudget ? Coarsest : Level);
+			Spent += Node.SplatCounts[Choice.Levels[N]];
+		}
+	}
+
+	if (bBudget && Spent < Budget)
+	{
+		// Greedy refinement. A node's next step jumps to the finer level with the best error reduction per splat
+		// (not just the adjacent one), which keeps each node's sequence of steps in decreasing value order.
+		struct FStep
+		{
+			double Value;
+			int32 Choice;
+			int32 Node;
+			uint32 Level;
+		};
+		auto NextStep = [&](int32 C, int32 N, FStep& Out) -> bool
+		{
+			const FGaussianStreamedLODNode& Node = Choices[C].LOD->Nodes[N];
+			const uint32 Current = Choices[C].Levels[N];
+			double Best = 0.0;
+			bool bFound = false;
+			for (int32 L = int32(Current) - 1; L >= int32(Targets[C][N]); --L)
+			{
+				if (Node.SplatCounts[L] == 0)
+				{
+					continue;
+				}
+				const double Gain = double(Node.Errors[Current]) - double(Node.Errors[L]);
+				const double Cost = double(Node.SplatCounts[L]) - double(Node.SplatCounts[Current]);
+				const double Value = Cost <= 0.0 ? UE_BIG_NUMBER : Coverage[C][N] * Gain / Cost;
+				if (Gain > 0.0 && Value > Best)
+				{
+					Best = Value;
+					Out = { Value, C, N, uint32(L) };
+					bFound = true;
+				}
+			}
+			return bFound;
+		};
+		auto ByValue = [](const FStep& A, const FStep& B) { return A.Value > B.Value; };
+		TArray<FStep> Heap;
+		for (int32 C = 0; C < Choices.Num(); ++C)
+		{
+			for (int32 N = 0; N < Choices[C].Levels.Num(); ++N)
+			{
+				FStep Step;
+				if (Choices[C].Levels[N] != MAX_uint32 && NextStep(C, N, Step))
+				{
+					Heap.HeapPush(Step, ByValue);
+				}
+			}
+		}
+		while (Heap.Num() > 0 && Spent < Budget)
+		{
+			FStep Step;
+			Heap.HeapPop(Step, ByValue);
+			const FGaussianStreamedLODNode& Node = Choices[Step.Choice].LOD->Nodes[Step.Node];
+			uint32& Level = Choices[Step.Choice].Levels[Step.Node];
+			const uint64 Before = Node.SplatCounts[Level];
+			if (Spent - Before + Node.SplatCounts[Step.Level] > Budget)
+			{
+				// Too big: try the adjacent finer level instead, else leave the node here
+				int32 Adjacent = int32(Level) - 1;
+				while (Adjacent >= int32(Step.Level) && Node.SplatCounts[Adjacent] == 0)
+				{
+					--Adjacent;
+				}
+				if (Adjacent <= int32(Step.Level) || Spent - Before + Node.SplatCounts[Adjacent] > Budget
+					|| Node.Errors[Adjacent] >= Node.Errors[Level])
+				{
+					continue;
+				}
+				Step.Level = uint32(Adjacent);
+			}
+			Spent = Spent - Before + Node.SplatCounts[Step.Level];
+			Level = Step.Level;
+			FStep Next;
+			if (NextStep(Step.Choice, Step.Node, Next))
+			{
+				Heap.HeapPush(Next, ByValue);
+			}
+		}
+	}
+
+	for (int32 C = 0; C < Choices.Num(); ++C)
+	{
+		FStreamedLODChoice& Choice = Choices[C];
+		Choice.Coverage = MoveTemp(Coverage[C]);
+		Choice.Selected = 0;
+		for (int32 N = 0; N < Choice.Levels.Num(); ++N)
+		{
+			if (Choice.Levels[N] != MAX_uint32)
+			{
+				Choice.Selected += Choice.LOD->Nodes[N].SplatCounts[Choice.Levels[N]];
+			}
+		}
+	}
+
+	static double LastLog = 0.0;
+	if (CVarGSStreamedLODStats.GetValueOnRenderThread() != 0 && FPlatformTime::Seconds() - LastLog > 1.0)
+	{
+		LastLog = FPlatformTime::Seconds();
+		for (const FStreamedLODChoice& Choice : Choices)
+		{
+			TArray<int32> Nodes;
+			TArray<uint64> Splats;
+			Nodes.Init(0, Choice.LOD->NumLevels);
+			Splats.Init(0, Choice.LOD->NumLevels);
+			for (int32 N = 0; N < Choice.Levels.Num(); ++N)
+			{
+				if (Choice.Levels[N] != MAX_uint32)
+				{
+					++Nodes[Choice.Levels[N]];
+					Splats[Choice.Levels[N]] += Choice.LOD->Nodes[N].SplatCounts[Choice.Levels[N]];
+				}
+			}
+			FString PerLevel;
+			for (int32 L = 0; L < Choice.LOD->NumLevels; ++L)
+			{
+				PerLevel += FString::Printf(TEXT(" L%d %d/%llu"), L, Nodes[L], Splats[L]);
+			}
+			UE_LOG(LogTemp, Display, TEXT("gs.StreamedLODStats: %llu splats selected (budget %s, threshold %.3f); nodes/splats per level:%s"),
+				Choice.Selected, bBudget ? *FString::Printf(TEXT("%llu"), Budget) : TEXT("none"), Choice.Threshold, *PerLevel);
+		}
+	}
+}
+
+/**
+ * Streamed SOG residency: keep the pages this view draws, ask for the levels it wants, move finished reads into the
+ * pools (GPU uploads before culling), then draw only resident levels. The coarsest level is always resident.
+ */
+static void ResolveStreamedResidency(FRHICommandListImmediate& RHICmdList, TArray<FStreamedLODChoice>& Choices)
+{
+	const uint64 Frame = GFrameNumberRenderThread;
+	TArray<FGaussianSplatRenderData*, TInlineAllocator<4>> Streaming;
+	for (FStreamedLODChoice& Choice : Choices)
+	{
+		FGaussianSplatRenderData* Data = Choice.Resources->GetSharedRenderData();
+		FGaussianStreamedResidency* Residency = Data ? Data->Residency.Get() : nullptr;
+		if (!Residency)
+		{
+			continue;
+		}
+		for (int32 N = 0; N < Choice.Levels.Num(); ++N)
+		{
+			if (Choice.Levels[N] != MAX_uint32)
+			{
+				Residency->Resolve(uint32(N), Choice.Levels[N], Frame);          // keeps what's drawn from eviction
+				Residency->Request(uint32(N), Choice.Levels[N], Choice.Coverage[N]);
+			}
+		}
+		Streaming.AddUnique(Data);
+	}
+	for (FGaussianSplatRenderData* Data : Streaming)
+	{
+		Data->Residency->Update(Frame, Data->DummyCluster);
+		FGaussianSplatRenderer::DispatchStreamedUploads(RHICmdList, *Data);
+	}
+	for (FStreamedLODChoice& Choice : Choices)
+	{
+		FGaussianSplatRenderData* Data = Choice.Resources->GetSharedRenderData();
+		if (!Data || !Data->Residency.IsValid())
+		{
+			continue;
+		}
+		Choice.Selected = 0;
+		for (int32 N = 0; N < Choice.Levels.Num(); ++N)
+		{
+			if (Choice.Levels[N] != MAX_uint32)
+			{
+				Choice.Levels[N] = Data->Residency->Resolve(uint32(N), Choice.Levels[N], Frame);
+				Choice.Selected += Choice.Levels[N] != MAX_uint32 ? Choice.LOD->Nodes[N].SplatCounts[Choice.Levels[N]] : 0;
+			}
+		}
+	}
+
+	static double LastLog = 0.0;
+	if (CVarGSStreamedLODStats.GetValueOnRenderThread() != 0 && Streaming.Num() > 0 && FPlatformTime::Seconds() - LastLog > 1.0)
+	{
+		LastLog = FPlatformTime::Seconds();
+		for (FGaussianSplatRenderData* Data : Streaming)
+		{
+			const FGaussianStreamedResidency::FStats Stats = Data->Residency->GetStats();
+			UE_LOG(LogTemp, Display, TEXT("gs.StreamedLODStats: residency %d/%d pages resident, %d loading, blocks %d/%d, %llu loads, %llu evictions, %llu failed reads"),
+				Stats.ResidentPages, Stats.TotalPages, Stats.LoadingPages, Stats.UsedBlocks, Stats.TotalBlocks,
+				Stats.Loads, Stats.Evictions, Stats.Failures);
+		}
+	}
+}
