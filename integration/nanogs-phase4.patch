+/**
+ * Streamed SOG residency (gs.StreamingPoolSplats > 0). The coarsest LOD level stays resident at the start of the
+ * record pool; every finer (node, level) run of the asset's records is a page, read on demand from the record bulk
+ * data into 128-record blocks of the pool, and evicted least recently used first when the pool is full. The level
+ * choice only ever draws resident levels (Resolve), so culling never meets a missing page.
+ *
+ * Render thread only, except Detach (any thread, while the render thread is idle or from a render command).
+ */
+class NANOGS_API FGaussianStreamedResidency
+{
+public:
+	static constexpr uint32 BlockRecords = 128;       // one cluster per block (clusters hold at most 128 splats)
+	static constexpr uint32 RecordBytes = 20;         // sog::PackedSplat
+
+	FGaussianStreamedResidency() = default;
+	~FGaussianStreamedResidency();                    // cancels and waits for reads in flight
+
+	/**
+	 * Build the page table. AssetClusters is the asset's cluster table (records in asset order); PoolSplats the room for
+	 * streamed records beyond the resident coarsest level; Source the asset's record bulk data.
+	 */
+	void Initialize(const FGaussianStreamedLOD& InLOD, const TArray<FGaussianGPUCluster>& AssetClusters, uint32 PoolSplats,
+		const FByteBulkData* InSource);
+
+	/** Records in the pool: the coarsest level, padding to a block boundary, then the blocks. */
+	uint32 GetPoolRecords() const { return PoolRecords; }
+	uint32 GetPinnedRecords() const { return PinnedRecords; }
+
+	/** The GPU cluster table with finer levels not resident, and the pool position -> cluster map (Dummy = none). */
+	void MakeInitialGPUState(TArray<FGaussianGPUCluster>& InOutClusters, TArray<uint32>& OutPoolClusters, uint32 Dummy) const;
+
+	/** The finest resident level of Node at or coarser than Desired (MAX_uint32: none); marks its page used this frame. */
+	uint32 Resolve(uint32 Node, uint32 Desired, uint64 Frame);
+
+	/** Ask for Node's Desired level; larger Priority loads first. Requests last one Update. */
+	void Request(uint32 Node, uint32 Desired, float Priority);
+
+	/**
+	 * Move finished reads into the pool (evicting pages not used this frame) and issue the requested reads. The GPU
+	 * writes this implies accumulate in GetUploads(). Returns true when the resident set changed.
+	 */
+	bool Update(uint64 Frame, uint32 DummyCluster);
+
+	/** GPU writes recorded by Update, consumed and reset by FGaussianSplatRenderer::DispatchStreamedUploads. */
+	struct FUploads
+	{
+		TArray<uint8> Records;                        // BlockRecords * RecordBytes per uploaded block, zero padded
+		TArray<FUintVector4> Blocks;                  // x = first pool record, y = cluster (or dummy), z = records, w = block in Records
+		TArray<FUintVector4> Clusters;                // x = cluster, y = first pool record, z = records (0: not resident)
+		bool IsEmpty() const { return Blocks.IsEmpty() && Clusters.IsEmpty(); }
+		void Reset() { Records.Reset(); Blocks.Reset(); Clusters.Reset(); }
+	};
+	FUploads& GetUploads() { return Uploads; }
+
+	/** Stop reading: cancel reads in flight and forget the source (its asset is being destroyed or changed). */
+	void Detach();
+
+	bool IsActive() const { return bActive; }
+	bool HasPendingReads() const { return Loading.Num() > 0; }
+	uint32 GetGeneration() const { return Generation; }           // changes whenever the resident set changes
+
+	struct FStats
+	{
+		int32 ResidentPages = 0, LoadingPages = 0, TotalPages = 0;
+		int32 UsedBlocks = 0, TotalBlocks = 0;
+		uint64 Loads = 0, Evictions = 0, Failures = 0;
+	};
+	FStats GetStats() const;
+
+private:
+	enum class EPageState : uint8 { Absent, Requested, Loading, Resident };
+
+	struct FPage
+	{
+		uint32 Node = 0;
+		uint32 Level = 0;
+		uint32 FirstCluster = 0;
+		uint32 NumClusters = 0;
+		uint32 RecordStart = 0;                       // in the asset's records
+		uint32 RecordCount = 0;
+		EPageState State = EPageState::Absent;
+		float Priority = 0.0f;
+		uint64 LastUsed = 0;
+		TArray<uint32> Blocks;                        // one per cluster while resident
+		FIoBuffer Data;
+		FBulkDataBatchRequest Read;
+	};
+
+	int32 PageOf(uint32 Node, uint32 Level) const { return PageIndex[int32(Node * uint32(NumLevels) + Level)]; }
+	uint32 BlockRecord(uint32 Block) const { return DynamicBase + Block * BlockRecords; }
+	bool Allocate(FPage& Page, uint64 Frame, uint32 DummyCluster);
+	void Evict(FPage& Page);
+
+	const FGaussianStreamedLOD* LOD = nullptr;
+	const FByteBulkData* Source = nullptr;
+	TArray<FGaussianGPUCluster> Clusters;             // the asset's cluster table (records in asset order)
+	TArray<FPage> Pages;
+	TArray<int32> PageIndex;                          // node * NumLevels + level -> page (INDEX_NONE: resident or absent)
+	TArray<int32> Requested;
+	TArray<int32> Loading;
+	TArray<uint32> FreeBlocks;
+	TBitArray<> FreedThisUpdate;                      // blocks freed by this Update: cleared on the GPU unless reused
+	TArray<uint32> FreedList;
+	FUploads Uploads;
+
+	int32 NumLevels = 0;
+	uint32 PinnedRecords = 0;
+	uint32 DynamicBase = 0;
+	uint32 NumBlocks = 0;
+	uint32 PoolRecords = 0;
+	uint32 Generation = 0;
+	bool bActive = false;
+	uint64 Loads = 0, Evictions = 0, Failures = 0;
+};
