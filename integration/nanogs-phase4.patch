diff -ruN a/Plugins/NanoGS/Shaders/Private/StreamedUpload.usf b/Plugins/NanoGS/Shaders/Private/StreamedUpload.usf
--- a/Plugins/NanoGS/Shaders/Private/StreamedUpload.usf	2026-09-29 19:11:57
+++ b/Plugins/NanoGS/Shaders/Private/StreamedUpload.usf	2026-09-29 19:11:57
@@ -0,0 +1,59 @@
+// Copyright Epic Games, Inc. All Rights Reserved.
+
+// Streamed SOG residency: move pages read from disk into the record pool and keep the cluster table in step
+// (FGaussianStreamedResidency::Update records the writes, FGaussianSplatRenderer::DispatchStreamedUploads runs them).
+
+#include "/Engine/Public/Platform.ush"
+#include "/Plugin/NanoGS/Private/GaussianDataTypes.ush"
+
+#define BLOCK_RECORDS 128
+#define RECORD_BYTES 20
+
+#if UPLOAD_BLOCKS
+
+// One group per block: x = first pool record, y = cluster (or DummyCluster to clear the block), z = records,
+// w = the block's index in UploadRecords
+ByteAddressBuffer UploadRecords;
+StructuredBuffer<uint4> UploadBlocks;
+RWByteAddressBuffer RecordPool;
+RWStructuredBuffer<uint> PoolClusterIndex;
+uint DummyCluster;
+
+[numthreads(BLOCK_RECORDS, 1, 1)]
+void UploadBlocksCS(uint3 GroupId : SV_GroupID, uint3 ThreadId : SV_GroupThreadID)
+{
+	const uint4 Block = UploadBlocks[GroupId.x];
+	const uint Index = ThreadId.x;
+	const uint Destination = Block.x + Index;
+	// Positions past the cluster's records (and cleared blocks) belong to no cluster
+	PoolClusterIndex[Destination] = Index < Block.z ? Block.y : DummyCluster;
+	if (Index < Block.z)
+	{
+		const uint Source = (Block.w * BLOCK_RECORDS + Index) * RECORD_BYTES;
+		RecordPool.Store4(Destination * RECORD_BYTES, UploadRecords.Load4(Source));
+		RecordPool.Store(Destination * RECORD_BYTES + 16, UploadRecords.Load(Source + 16));
+	}
+}
+
+#endif
+
+#if UPDATE_CLUSTERS
+
+// x = cluster, y = first pool record, z = records (0: not resident)
+StructuredBuffer<uint4> ClusterUpdates;
+RWStructuredBuffer<FGaussianGPUCluster> ClusterBufferRW;
+uint NumClusterUpdates;
+
+[numthreads(64, 1, 1)]
+void UpdateClustersCS(uint3 DispatchThreadId : SV_DispatchThreadID)
+{
+	if (DispatchThreadId.x >= NumClusterUpdates)
+	{
+		return;
+	}
+	const uint4 Update = ClusterUpdates[DispatchThreadId.x];
+	ClusterBufferRW[Update.x].SplatStartIndex = Update.y;
+	ClusterBufferRW[Update.x].SplatCount = Update.z;
+}
+
+#endif
