+	/** Static buffer holding Data (at least 16 bytes), with a raw (Stride 0) or structured SRV. */
+	FShaderResourceViewRHIRef MakeUploadBuffer(FRHICommandListImmediate& RHICmdList, const TCHAR* Name, const void* Data,
+		uint32 NumBytes, uint32 Stride, FBufferRHIRef& OutBuffer)
+	{
+		const uint32 Size = FMath::Max(NumBytes, 16u);
+		const EBufferUsageFlags Usage = BUF_Static | BUF_ShaderResource | (Stride == 0 ? BUF_ByteAddressBuffer : BUF_StructuredBuffer);
+		OutBuffer = RHICmdList.CreateBuffer(FRHIBufferCreateDesc::Create(Name, Size, Stride, Usage).SetInitialState(ERHIAccess::SRVMask));
+		void* Dest = RHICmdList.LockBuffer(OutBuffer, 0, Size, RLM_WriteOnly);
+		FMemory::Memzero(Dest, Size);
+		FMemory::Memcpy(Dest, Data, NumBytes);
+		RHICmdList.UnlockBuffer(OutBuffer);
+		return RHICmdList.CreateShaderResourceView(OutBuffer, Stride == 0
+			? FRHIViewDesc::CreateBufferSRV().SetType(FRHIViewDesc::EBufferType::Raw)
+			: FRHIViewDesc::CreateBufferSRV().SetType(FRHIViewDesc::EBufferType::Structured).SetStride(Stride));
+	}
+}
