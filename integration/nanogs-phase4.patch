+		NodeLevelBufferSRV = RHICmdList.CreateShaderResourceView(
+			NodeLevelBuffer, FRHIViewDesc::CreateBufferSRV()
 				.SetType(FRHIViewDesc::EBufferType::Structured)
 				.SetStride(sizeof(uint32)));
 	}
@@ -722,6 +723,28 @@
 	bSupportsCompaction = true;
 	UE_LOG(LogTemp, Verbose, TEXT("GaussianSplatGPUResources: Created splat compaction buffers for %d total splats"), TotalSplatCount);
 	UE_LOG(LogTemp, Verbose, TEXT("GaussianSplatGPUResources: Created cluster buffers for %d clusters"), ClusterCount);
+}
+
+const FGaussianStreamedLOD* FGaussianSplatGPUResources::GetStreamedLOD() const
+{
+	return bStreamedLOD && SharedData.IsValid() && SharedData->bStreamedLOD ? &SharedData->StreamedLOD : nullptr;
+}
+
+int32 FGaussianSplatGPUResources::GetRecordRange() const
+{
+	return SharedData.IsValid() && SharedData->Residency.IsValid() ? int32(SharedData->PoolRecords) : SplatCount;
+}
+
+void FGaussianSplatGPUResources::UploadNodeLevels(FRHICommandListBase& RHICmdList, const TArray<uint32>& NodeLevels)
+{
+	if (!NodeLevelBuffer.IsValid() || NodeLevels.Num() == 0)
+	{
+		return;
+	}
+	const uint32 Bytes = FMath::Min<uint32>(NodeLevels.Num() * sizeof(uint32), NodeLevelBuffer->GetSize());
+	void* Data = RHICmdList.LockBuffer(NodeLevelBuffer, 0, Bytes, RLM_WriteOnly);
+	FMemory::Memcpy(Data, NodeLevels.GetData(), Bytes);
+	RHICmdList.UnlockBuffer(NodeLevelBuffer);
 }
 
