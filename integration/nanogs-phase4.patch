+UGaussianSplatAsset* UGaussianSplatAssetFactory::ImportStreamedSOGFile(
+	const FString& FilePath,
+	UObject* InParent,
+	FName InName,
+	EObjectFlags Flags,
+	UGaussianSplatAsset* ExistingAsset)
+{
+	FScopedSlowTask SlowTask(100.0f, FText::FromString(TEXT("Importing Streamed SOG Gaussian Splat...")));
+	SlowTask.MakeDialog(true);
+
+	// Load every chunk and merge the levels: shared codebooks, one SH palette, records coarsest level first
+	SlowTask.EnterProgressFrame(60.0f, FText::FromString(TEXT("Merging LOD chunks...")));
+	sog::StreamedAsset Streamed;
+	FString ErrorMessage;
+	if (!NanoGSReadStreamedSOG(FilePath, Streamed, ErrorMessage))
+	{
+		UE_LOG(LogTemp, Error, TEXT("Failed to read Streamed SOG: %s"), *ErrorMessage);
+		return nullptr;
+	}
+	const sog::DecodedAsset& Merged = Streamed.merged;
+	UE_LOG(LogTemp, Log, TEXT("Read Streamed SOG: %u splats in %u levels, %d leaves, %d clusters, SH bands %u, palette %u (from %llu chunk palette entries), errors %s"),
+		Merged.count, Streamed.lodLevels, int32(Streamed.leaves.size()), int32(Streamed.clusters.size()), Merged.shBands, Merged.paletteCount,
+		(unsigned long long)Streamed.sourcePaletteEntries, Streamed.errorsFromFile ? TEXT("from the file") : TEXT("from splat counts"));
+
+	// Per-node LOD table and clusters, bounds in local space
+	SlowTask.EnterProgressFrame(10.0f, FText::FromString(TEXT("Building LOD table...")));
+	const float* FileToLocal = sog::kNanoGSFileToLocal;
+	const int32 NumLevels = int32(Streamed.lodLevels);
+	FGaussianStreamedLOD LOD;
+	LOD.NumLevels = NumLevels;
+	LOD.bErrorsFromFile = Streamed.errorsFromFile;
+	for (uint64 Count : Streamed.levelCounts)
+	{
+		LOD.LevelSplatCounts.Add(Count);
+	}
+	LOD.Nodes.SetNum(int32(Streamed.leaves.size()));
+	for (int32 Index = 0; Index < LOD.Nodes.Num(); ++Index)
+	{
+		const sog::StreamedLeaf& Leaf = Streamed.leaves[size_t(Index)];
+		FGaussianStreamedLODNode& Node = LOD.Nodes[Index];
+		FileBoundsToLocal(Leaf.boundMin, Leaf.boundMax, FileToLocal, Node.BoundsMin, Node.BoundsMax);
+		Node.Errors = TArray<float>(Leaf.errors.data(), int32(Leaf.errors.size()));
+		Node.SplatCounts.Init(0, NumLevels);
+		Node.FirstCluster.Init(0, NumLevels);
+		Node.ClusterCounts.Init(0, NumLevels);
+		for (int32 Level = 0; Level < NumLevels; ++Level)
+		{
+			Node.SplatCounts[Level] = Leaf.levels[size_t(Level)].count;
+		}
+	}
+	TArray<UGaussianSplatAsset::FStreamedClusterDesc> Clusters;
+	Clusters.SetNum(int32(Streamed.clusters.size()));
+	for (int32 Index = 0; Index < Clusters.Num(); ++Index)
+	{
+		const sog::StreamedCluster& Source = Streamed.clusters[size_t(Index)];
+		UGaussianSplatAsset::FStreamedClusterDesc& Desc = Clusters[Index];
+		Desc.Node = Source.leaf;
+		Desc.Level = Source.level;
+		Desc.SplatStart = Source.start;
+		Desc.SplatCount = Source.count;
+		FileBoundsToLocal(Source.boundMin, Source.boundMax, FileToLocal, Desc.BoundsMin, Desc.BoundsMax);
+		FGaussianStreamedLODNode& Node = LOD.Nodes[int32(Source.leaf)];
+		if (Node.ClusterCounts[int32(Source.level)]++ == 0)
+		{
+			Node.FirstCluster[int32(Source.level)] = uint32(Index);        // a run's clusters are consecutive
+		}
+	}
+
+	// The finest level gives the thumbnail
+	SlowTask.EnterProgressFrame(10.0f, FText::FromString(TEXT("Decoding preview...")));
+	TArray<FGaussianSplatData> Preview;
+	{
+		sog::DecodedAsset Finest = Merged;
+		uint32 Start = Merged.count;
+		for (const sog::StreamedLeaf& Leaf : Streamed.leaves)
+		{
+			if (Leaf.levels[0].count > 0)
+			{
+				Start = FMath::Min(Start, Leaf.levels[0].start);
+			}
+		}
+		Finest.splats.assign(Merged.splats.begin() + Start, Merged.splats.end());
+		Finest.count = uint32(Finest.splats.size());
+		GaussianSplatSOG::ToSplatData(Finest, Preview);
+	}
+
+	SlowTask.EnterProgressFrame(20.0f, FText::FromString(TEXT("Storing SOG records...")));
+	UGaussianSplatAsset* Asset = ExistingAsset;
+	if (!Asset)
+	{
+		Asset = NewObject<UGaussianSplatAsset>(InParent, UGaussianSplatAsset::StaticClass(), InName, Flags);
+	}
+	if (!Asset)
+	{
+		UE_LOG(LogTemp, Error, TEXT("Failed to create Gaussian Splat asset"));
+		return nullptr;
+	}
+	Asset->SourceFilePath = FilePath;
+	Asset->InitializeFromStreamedSOG(Preview, Merged, Clusters, MoveTemp(LOD), QualityLevel);
+	Asset->MarkPackageDirty();
+
+	UE_LOG(LogTemp, Log, TEXT("Successfully imported Streamed SOG Gaussian Splat asset: %d splats, %lld bytes (SOG records %lld, palette %lld)"),
+		Asset->GetSplatCount(), Asset->GetMemoryUsage(), Asset->GetSOGRecordDataSize(), Asset->GetSOGPaletteDataSize());
+	return Asset;
 }
 
