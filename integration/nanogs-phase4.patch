+
+void Run(const ParallelFor& parallelFor, size_t count, const std::function<void(size_t)>& body)
+{
+    if (parallelFor && count > 1) {
+        parallelFor(count, body);
+        return;
+    }
+    for (size_t i = 0; i < count; ++i) {
+        body(i);
+    }
