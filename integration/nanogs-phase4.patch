+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FNanoGSSOGStreamedImportTest, "NanoGS.SOG.StreamedImportSaveReload",
+	EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FNanoGSSOGStreamedImportTest::RunTest(const FString& Parameters)
+{
+	const FString Dir = TestDataDir();
+	const FString SourcePath = Dir / TEXT("streamed/scene/lod-meta.json");
+	if (Dir.IsEmpty() || !FPaths::FileExists(SourcePath))
+	{
+		AddInfo(TEXT("NANOGS_SOG_TESTDATA/streamed/scene/lod-meta.json not found; skipping (tools/phase4/make_streamed.sh)"));
+		return true;
+	}
+	const FString PackageName = TEXT("/Game/NanoGS_SOGTest_Temp/StreamedTest");
+	const FString PackageFile = FPackageName::LongPackageNameToFilename(PackageName, FPackageName::GetAssetPackageExtension());
+
+	UPackage* Package = CreatePackage(*PackageName);
+	UGaussianSplatAssetFactory* Factory = NewObject<UGaussianSplatAssetFactory>();
+	TestTrue(TEXT("Factory accepts lod-meta.json"), Factory->FactoryCanImport(SourcePath));
+	bool bCanceled = false;
+	const double Start = FPlatformTime::Seconds();
+	UGaussianSplatAsset* Asset = Cast<UGaussianSplatAsset>(Factory->FactoryCreateFile(UGaussianSplatAsset::StaticClass(),
+		Package, TEXT("StreamedTest"), RF_Public | RF_Standalone, SourcePath, nullptr, GWarn, bCanceled));
+	if (!TestNotNull(TEXT("Factory imports the Streamed SOG"), Asset))
+	{
+		return false;
+	}
+	const double ImportSeconds = FPlatformTime::Seconds() - Start;
+	TestTrue(TEXT("Asset has a streamed LOD table"), Asset->HasStreamedLOD());
+	TestTrue(TEXT("Asset renders through cluster culling"), Asset->IsNaniteEnabled() && Asset->HasClusterHierarchy());
+	const FGaussianStreamedLOD& LOD = Asset->GetStreamedLOD();
+	const TArray<FGaussianCluster>& Clusters = Asset->GetClusterHierarchy().Clusters;
+	const int32 Total = Asset->GetSplatCount();
+
+	// The LOD table and the clusters agree, and together they tile the records coarsest level first
+	TArray<uint8> Covered;
+	Covered.Init(0, Total);
+	bool bConsistent = LOD.NumLevels > 0 && LOD.LevelSplatCounts.Num() == LOD.NumLevels;
+	bool bErrorsMonotone = true;
+	int32 ClusterSum = 0;
+	TArray<uint64> LevelSums;
+	LevelSums.Init(0, LOD.NumLevels);
+	for (const FGaussianStreamedLODNode& Node : LOD.Nodes)
+	{
+		bConsistent = bConsistent && Node.Errors.Num() == LOD.NumLevels && Node.SplatCounts.Num() == LOD.NumLevels;
+		for (int32 Level = 0; bConsistent && Level < LOD.NumLevels; ++Level)
+		{
+			bErrorsMonotone = bErrorsMonotone && (Level == 0 || Node.Errors[Level] >= Node.Errors[Level - 1]);
+			uint32 Splats = 0;
+			for (uint32 C = Node.FirstCluster[Level]; C < Node.FirstCluster[Level] + Node.ClusterCounts[Level]; ++C)
+			{
+				const FGaussianCluster& Cluster = Clusters[int32(C)];
+				bConsistent = bConsistent && Cluster.LODLevel == uint32(Level) && Cluster.SplatCount >= 1 && Cluster.SplatCount <= 128
+					&& Cluster.IsLeaf() && Cluster.SplatStartIndex + Cluster.SplatCount <= uint32(Total);
+				for (uint32 I = Cluster.SplatStartIndex; bConsistent && I < Cluster.SplatStartIndex + Cluster.SplatCount; ++I)
+				{
+					bConsistent = Covered[int32(I)]++ == 0;
+				}
+				Splats += Cluster.SplatCount;
+			}
+			bConsistent = bConsistent && Splats == Node.SplatCounts[Level];
+			ClusterSum += int32(Node.ClusterCounts[Level]);
+			LevelSums[Level] += Splats;
+		}
+	}
+	bConsistent = bConsistent && ClusterSum == Clusters.Num() && !Covered.Contains(0);
+	for (int32 Level = 0; bConsistent && Level < LOD.NumLevels; ++Level)
+	{
+		bConsistent = LevelSums[Level] == LOD.LevelSplatCounts[Level];
+	}
+	TestTrue(TEXT("Nodes, clusters and records are consistent (every record in exactly one cluster)"), bConsistent);
+	TestTrue(TEXT("Errors are non-decreasing toward coarser levels"), bErrorsMonotone);
+	bool bCoarsestPrefix = true;
+	const uint64 Coarsest = LOD.LevelSplatCounts.Last();
+	for (const FGaussianCluster& Cluster : Clusters)
+	{
+		bCoarsestPrefix = bCoarsestPrefix && ((Cluster.LODLevel == uint32(LOD.NumLevels - 1)) == (Cluster.SplatStartIndex < Coarsest));
+	}
+	TestTrue(TEXT("The coarsest level is a prefix of the records"), bCoarsestPrefix);
+	AddInfo(FString::Printf(TEXT("Streamed import: %d splats, %d levels, %d nodes, %d clusters, palette %d, max selectable %u, %.1f s (errors %s)"),
+		Total, LOD.NumLevels, LOD.Nodes.Num(), Clusters.Num(), Asset->SOGPaletteCount, LOD.GetMaxSelectableSplats(), ImportSeconds,
+		LOD.bErrorsFromFile ? TEXT("from the file") : TEXT("derived")));
+
+	// Records are the merge's output, unchanged
+	sog::StreamedAsset Merged;
+	FString Error;
+	TArray<uint8> Records;
+	Asset->GetSOGRecordData(Records);
+	if (TestTrue(TEXT("Reader merges the same file"), NanoGSReadStreamedSOG(SourcePath, Merged, Error)))
+	{
+		TestTrue(TEXT("Asset records equal the merged records"), Records.Num() == int32(Merged.merged.splats.size() * sizeof(sog::PackedSplat))
+			&& FMemory::Memcmp(Records.GetData(), Merged.merged.splats.data(), Records.Num()) == 0);
+	}
+	TestFalse(TEXT("A Nanite rebuild is refused for Streamed SOG"), Asset->BuildNaniteClusterHierarchy());
+
+	// Save (version 7) and reload
+	FSavePackageArgs SaveArgs;
+	SaveArgs.TopLevelFlags = RF_Public | RF_Standalone;
+	SaveArgs.SaveFlags = SAVE_NoError;
+	const bool bSaved = UPackage::SavePackage(Package, Asset, *PackageFile, SaveArgs);
+	TestTrue(TEXT("Package saves"), bSaved);
+	Package->Rename(*FString::Printf(TEXT("/Temp/NanoGS_StreamedTest_Old_%s"), *FGuid::NewGuid().ToString()),
+		nullptr, REN_DontCreateRedirectors | REN_NonTransactional);
+	UPackage* Reloaded = bSaved ? LoadPackage(nullptr, *PackageName, LOAD_None) : nullptr;
+	UGaussianSplatAsset* ReloadedAsset = Reloaded ? FindObject<UGaussianSplatAsset>(Reloaded, TEXT("StreamedTest")) : nullptr;
+	if (TestNotNull(TEXT("Saved asset reloads"), ReloadedAsset))
+	{
+		const FGaussianStreamedLOD& Loaded = ReloadedAsset->GetStreamedLOD();
+		bool bSame = ReloadedAsset->HasStreamedLOD() && Loaded.NumLevels == LOD.NumLevels && Loaded.Nodes.Num() == LOD.Nodes.Num()
+			&& Loaded.LevelSplatCounts == LOD.LevelSplatCounts && Loaded.bErrorsFromFile == LOD.bErrorsFromFile;
+		for (int32 N = 0; bSame && N < LOD.Nodes.Num(); ++N)
+		{
+			const FGaussianStreamedLODNode& A = LOD.Nodes[N];
+			const FGaussianStreamedLODNode& B = Loaded.Nodes[N];
+			bSame = A.BoundsMin == B.BoundsMin && A.BoundsMax == B.BoundsMax && A.Errors == B.Errors && A.SplatCounts == B.SplatCounts
+				&& A.FirstCluster == B.FirstCluster && A.ClusterCounts == B.ClusterCounts;
+		}
+		TestTrue(TEXT("Reloaded LOD table identical"), bSame);
+		TArray<uint8> ReloadedRecords;
+		ReloadedAsset->GetSOGRecordData(ReloadedRecords);
+		TestTrue(TEXT("Reloaded records identical"), ReloadedRecords == Records);
+		TestEqual(TEXT("Reloaded cluster count"), ReloadedAsset->GetClusterCount(), Clusters.Num());
 		ReloadedAsset->ClearFlags(RF_Public | RF_Standalone);
 		ReloadedAsset->MarkAsGarbage();
 		ResetLoaders(Reloaded);
