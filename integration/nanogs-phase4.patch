+bool NanoGSReadStreamedSOG(const FString& LodMetaPath, sog::StreamedAsset& Out, FString& OutError)
+{
+	TArray<uint8> Bytes;
+	if (!FFileHelper::LoadFileToArray(Bytes, *LodMetaPath))
+	{
+		OutError = FString::Printf(TEXT("Cannot read %s"), *LodMetaPath);
+		return false;
+	}
+	sog::LodMeta Meta;
+	std::string Error;
+	sog::Error Result = sog::ParseLodMeta(reinterpret_cast<const char*>(Bytes.GetData()), size_t(Bytes.Num()), Meta, &Error);
+	if (Result != sog::Error::Ok)
+	{
+		OutError = FString::Printf(TEXT("%s: %s (%s)"), *LodMetaPath, *ToFString(Error), *ToFString(sog::ErrorName(Result)));
+		return false;
+	}
+	if (!Meta.environment.empty())
+	{
+		UE_LOG(LogTemp, Warning, TEXT("Streamed SOG: the environment chunk %s isn't imported (only the LOD tree is)"),
+			*ToFString(Meta.environment));
+	}
+
+	// Chunks are unbundled SOG folders named by their meta.json ("0_0/meta.json") or .sog bundles, relative to lod-meta.json
+	const FString Directory = FPaths::GetPath(LodMetaPath);
+	const sog::ChunkOpener Open = [Directory](const std::string& Path, std::string* OpenError) -> std::unique_ptr<sog::FileSource>
+	{
+		const FString Relative = ToFString(Path);
+		const FString Full = FPaths::Combine(Directory, Relative);
+		if (FPaths::GetCleanFilename(Relative).Equals(TEXT("meta.json"), ESearchCase::IgnoreCase))
+		{
+			return std::make_unique<FFolderSource>(FPaths::GetPath(Full));
+		}
+		TArray<uint8> ChunkBytes;
+		if (!FFileHelper::LoadFileToArray(ChunkBytes, *Full))
+		{
+			if (OpenError) { *OpenError = "cannot read " + Path; }
+			return nullptr;
+		}
+		return sog::MakeZipSource(std::vector<uint8_t>(ChunkBytes.GetData(), ChunkBytes.GetData() + ChunkBytes.Num()), OpenError);
+	};
+
+	sog::StreamedOptions Options;
+	Options.parallelFor = [](size_t Count, const std::function<void(size_t)>& Body)
+	{
+		ParallelFor(int32(Count), [&Body](int32 Index) { Body(size_t(Index)); });
+	};
+	Options.progress = [](const char* Stage)
+	{
+		UE_LOG(LogTemp, Log, TEXT("Streamed SOG import: %s"), UTF8_TO_TCHAR(Stage));
+	};
+	Result = sog::LoadStreamed(Meta, Open, Options, Out, &Error);
+	if (Result != sog::Error::Ok)
+	{
+		OutError = FString::Printf(TEXT("%s: %s (%s)"), *LodMetaPath, *ToFString(Error), *ToFString(sog::ErrorName(Result)));
 		return false;
 	}
 	return true;
