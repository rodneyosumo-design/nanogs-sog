+// Sort key for a ViewDataBuffer entry. Ascending order is back-to-front; culled splats sort last.
+void WriteSortKey(uint outputIndex, float4 clipPos, bool bCulled)
+{
+	if (WriteSortKeys == 0u)
+	{
+		return;
+	}
+	uint key;
+	if (bCulled)
+	{
+		key = (SortKeyBits == 16u) ? 0xFFFFu : 0xFFFFFFFFu;
+	}
+	else if (SortKeyBits == 16u)
+	{
+		// Clip w is the view depth. Keys fall as depth grows; 0xFFFF stays reserved for culled splats.
+		// 65535 log steps over near..far (10 cm..1 km by default) resolve 0.014% of the depth.
+		float t = saturate((log2(clipPos.w) - SortKeyLogNear) * SortKeyInvLogRange);
+		key = (uint)round((1.0 - t) * 65534.0);
+	}
+	else
+	{
+		// Reversed-Z device depth (near = 1, far = 0) as a sortable uint: ascending = far first
+		key = asuint(clipPos.z / clipPos.w);
