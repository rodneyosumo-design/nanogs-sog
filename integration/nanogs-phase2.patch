+	FVector3f DecodePosition(const sog::AssetConstants& Constants, const sog::PackedSplat& Record)
+	{
+		const uint32 Q[3] = { Record.meanXY & 0xFFFFu, Record.meanXY >> 16, Record.meanZ_label & 0xFFFFu };
+		double File[3];
+		for (int32 K = 0; K < 3; ++K)
+		{
+			const double N = double(Constants.meanMin[K]) + (double(Constants.meanMax[K]) - double(Constants.meanMin[K])) * (double(Q[K]) / 65535.0);
+			File[K] = N < 0.0 ? -(FMath::Exp(-N) - 1.0) : FMath::Exp(N) - 1.0;
+		}
+		// fileToLocal is column-major: element (row r, column c) at [c * 4 + r]
+		const float* M = Constants.fileToLocal;
+		double Local[3];
+		for (int32 Row = 0; Row < 3; ++Row)
+		{
+			Local[Row] = M[Row] * File[0] + M[4 + Row] * File[1] + M[8 + Row] * File[2] + M[12 + Row];
+		}
+		return FVector3f(float(Local[0]), float(Local[1]), float(Local[2]));
+	}
