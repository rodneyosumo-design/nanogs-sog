+// Pipeline state for the splat draw. RT0 is the sRGB intermediate (premultiplied alpha, CW_RGBA so the
+// composite knows the accumulated alpha). With velocity: RT1 takes the splat-centre velocity (replace) and
+// the stencil gets STENCIL_TEMPORAL_RESPONSIVE_AA_MASK (bit 3 = 0x08) so TSR/TAA trusts history less on
+// splat pixels. Depth: DepthNearOrEqual test against the scene, with splat-centre writes (TSR disocclusion,
+// translucency occlusion) or read-only.
+static void SetSplatPipelineState(FRHICommandList& RHICmdList, const FGaussianSplatRasterMode& Mode,
+	FRHIVertexShader* VertexShaderRHI, FRHIPixelShader* PixelShaderRHI)
+{
+	FGraphicsPipelineStateInitializer GraphicsPSOInit;
+	RHICmdList.ApplyCachedRenderTargets(GraphicsPSOInit);
+	GraphicsPSOInit.RasterizerState = TStaticRasterizerState<FM_Solid, CM_None>::GetRHI();
+
+	if (!Mode.bHasDepth)
+	{
+		GraphicsPSOInit.DepthStencilState = TStaticDepthStencilState<false, CF_Always>::GetRHI();
+	}
+	else if (Mode.bWriteVelocity)
+	{
+		GraphicsPSOInit.DepthStencilState = Mode.bWriteDepth
+			? TStaticDepthStencilState<true, CF_DepthNearOrEqual,
+				true, CF_Always, SO_Keep, SO_Keep, SO_Replace, false, CF_Always, SO_Keep, SO_Keep, SO_Keep, 0x08, 0x08>::GetRHI()
+			: TStaticDepthStencilState<false, CF_DepthNearOrEqual,
+				true, CF_Always, SO_Keep, SO_Keep, SO_Replace, false, CF_Always, SO_Keep, SO_Keep, SO_Keep, 0x08, 0x08>::GetRHI();
+	}
+	else
+	{
+		GraphicsPSOInit.DepthStencilState = Mode.bWriteDepth
+			? TStaticDepthStencilState<true, CF_DepthNearOrEqual>::GetRHI()
+			: TStaticDepthStencilState<false, CF_DepthNearOrEqual>::GetRHI();
+	}
+
+	GraphicsPSOInit.BlendState = Mode.bWriteVelocity
+		? TStaticBlendState<
+			CW_RGBA, BO_Add, BF_One, BF_InverseSourceAlpha, BO_Add, BF_One, BF_InverseSourceAlpha,  // RT0: premultiplied over
+			CW_RGBA, BO_Add, BF_One, BF_Zero, BO_Add, BF_One, BF_Zero>::GetRHI()                     // RT1: velocity, replace
+		: TStaticBlendState<
+			CW_RGBA, BO_Add, BF_One, BF_InverseSourceAlpha, BO_Add, BF_One, BF_InverseSourceAlpha>::GetRHI();
+	GraphicsPSOInit.PrimitiveType = PT_TriangleList;
+	GraphicsPSOInit.BoundShaderState.VertexDeclarationRHI = GEmptyVertexDeclaration.VertexDeclarationRHI;
+	GraphicsPSOInit.BoundShaderState.VertexShaderRHI = VertexShaderRHI;
+	GraphicsPSOInit.BoundShaderState.PixelShaderRHI = PixelShaderRHI;
+
+	SetGraphicsPipelineState(RHICmdList, GraphicsPSOInit, Mode.bWriteVelocity ? 0x08 : 0);
+}
