+// Reversed-Z device depths within 10% of each other: the same surface (relative view depth for a perspective view)
+bool SimilarDepth(float a, float b)
+{
+	return abs(a - b) <= 0.1 * max(max(a, b), 1e-7);
+}
+
+// Bilinear upsample of the low-res splat layer that ignores taps whose depth doesn't match this pixel's
+// scene depth. At an occluder's silhouette the low-res pixels touching the occluder were depth-tested against
+// the occluder (its depth is the nearest in their footprint), so background pixels skip them and occluder
+// pixels skip the background taps: no halo in either direction.
+float4 UpsampleSplats(int2 PixelPos)
+{
+	const float2 lowPos = (float2(PixelPos) + 0.5 - ViewRectMin) * FullToLowScale - 0.5;
+	const int2 base = int2(floor(lowPos));
+	const float2 f = lowPos - float2(base);
+	const float sceneDepth = SceneDepthTexture.Load(int3(PixelPos, 0)).r;
+
+	float4 sum = 0;
+	float weightSum = 0;
+	float4 nearest = 0;
+	float nearestError = 1e30;
+	[unroll]
+	for (int i = 0; i < 4; i++)
+	{
+		const int2 offset = int2(i & 1, i >> 1);
+		const int2 tap = clamp(base + offset, int2(0, 0), LowResMax);
+		const float tapDepth = LowResDepthTexture.Load(int3(tap, 0)).r;
+		const float4 tapColor = IntermediateTexture.Load(int3(tap, 0));
+		const float bilinear = (offset.x ? f.x : 1.0 - f.x) * (offset.y ? f.y : 1.0 - f.y);
+		const float error = abs(tapDepth - sceneDepth);
+		if (error < nearestError)
+		{
+			nearestError = error;
+			nearest = tapColor;
+		}
+		if (SimilarDepth(tapDepth, sceneDepth))
+		{
+			sum += bilinear * tapColor;
+			weightSum += bilinear;
+		}
+	}
+	// No tap on this pixel's surface (thin features): take the closest one in depth
+	return weightSum > 1e-4 ? sum / weightSum : nearest;
+}
+
+// Reduced-resolution depth for the splat pass: the nearest scene depth (reversed Z: the largest) over each
+// low-res pixel's footprint, so occluders hide splats wherever they cover part of a low-res pixel.
+float DownsampleDepthPS(FCompositeVSOutput Input) : SV_Depth
+{
+	const int2 lowPixel = int2(Input.Position.xy);
+	const float2 center = (float2(lowPixel) + 0.5) / FullToLowScale + ViewRectMin;   // footprint centre, full res
+	const float2 halfSize = 0.5 / FullToLowScale;
+	const int2 first = int2(floor(center - halfSize + 0.5));
+	const int2 last = int2(floor(center + halfSize - 0.5));
+	float nearest = 0;
+	for (int y = first.y; y <= last.y; y++)
+	{
+		for (int x = first.x; x <= last.x; x++)
+		{
+			nearest = max(nearest, SceneDepthTexture.Load(int3(x, y, 0)).r);
+		}
+	}
+	return nearest;
+}
