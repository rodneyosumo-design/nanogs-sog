+static FGaussianSplatLowRes GetLowRes(const FSceneView& View, const FRDGTexture* DepthTexture, bool bWriteVelocity)
+{
+	// Temporal AA needs the full-resolution velocity target, so reduced resolution only applies without it
+	FGaussianSplatLowRes LowRes;
+	const float Percent = FMath::Clamp(CVarGSScreenPercentage.GetValueOnRenderThread(), 25.0f, 100.0f);
+	if (Percent >= 100.0f || bWriteVelocity || !DepthTexture || DepthTexture->Desc.NumSamples > 1)
+	{
+		return LowRes;
+	}
+	const FIntPoint ViewSize = static_cast<const FViewInfo&>(View).ViewRect.Size();
+	LowRes.Extent = FIntPoint(
+		FMath::Max(1, FMath::CeilToInt(ViewSize.X * Percent / 100.0f)),
+		FMath::Max(1, FMath::CeilToInt(ViewSize.Y * Percent / 100.0f)));
+	LowRes.FullToLowScale = FVector2f(float(LowRes.Extent.X) / ViewSize.X, float(LowRes.Extent.Y) / ViewSize.Y);
+	LowRes.bEnabled = true;
+	return LowRes;
