+/**
+ * Render budget: poll the visible-count readback and scale the LOD error threshold so the visible splats
+ * fit the budget. The splat count falls roughly with the square of the threshold, hence the square roots.
+ * Coarsens above 95% of the budget toward 90%, relaxes only below 70%, so it doesn't oscillate.
+ */
+static void UpdateBudgetLODScale(FGaussianGlobalAccumulator& Accumulator, uint32 Budget)
+{
+	if (Budget == 0)
+	{
+		Accumulator.BudgetLODScale = 1.0f;
+		return;
+	}
+	if (!Accumulator.bVisibleCountReadbackPending || !Accumulator.VisibleCountReadback->IsReady())
+	{
+		return;
+	}
+	const uint32 NumProxies = Accumulator.VisibleCountReadbackProxies;
+	const uint32* Counts = static_cast<const uint32*>(Accumulator.VisibleCountReadback->Lock(NumProxies * sizeof(uint32)));
+	uint64 Visible = 0;
+	for (uint32 Index = 0; Index < NumProxies; ++Index)
+	{
+		Visible += Counts[Index];
+	}
+	Accumulator.VisibleCountReadback->Unlock();
+	Accumulator.bVisibleCountReadbackPending = false;
+
+	const double Target = 0.9 * Budget;
+	double Scale = Accumulator.BudgetLODScale;
+	if (Visible > 0.95 * Budget)   // keep 5% headroom for camera motion
+	{
+		Scale *= FMath::Clamp(FMath::Sqrt(double(Visible) / Target), 1.05, 2.0);
+	}
+	else if (Visible < 0.7 * Budget && Scale > 1.0)
+	{
+		Scale *= FMath::Clamp(FMath::Sqrt(double(Visible) / Target), 0.8, 0.98);
+	}
+	Accumulator.BudgetLODScale = float(FMath::Clamp(Scale, 1.0, 64.0));
+}
+
+/** After the visible-count prefix sum: copy the per-proxy (uncapped) counts for UpdateBudgetLODScale. */
+static void EnqueueVisibleCountReadback(FRHICommandListImmediate& RHICmdList, FGaussianGlobalAccumulator* Accumulator, uint32 NumProxies)
+{
+	if (Accumulator->bVisibleCountReadbackPending || NumProxies == 0 || !Accumulator->GlobalVisibleCountArrayBuffer.IsValid())
+	{
+		return;
+	}
+	if (!Accumulator->VisibleCountReadback.IsValid())
+	{
+		Accumulator->VisibleCountReadback = MakeUnique<FRHIGPUBufferReadback>(TEXT("NanoGSVisibleCounts"));
+	}
+	// DispatchPrefixSumVisibleCounts leaves the counts in SRVCompute
+	RHICmdList.Transition(FRHITransitionInfo(Accumulator->GlobalVisibleCountArrayBuffer, ERHIAccess::SRVCompute, ERHIAccess::CopySrc));
+	Accumulator->VisibleCountReadback->EnqueueCopy(RHICmdList, Accumulator->GlobalVisibleCountArrayBuffer, NumProxies * sizeof(uint32));
+	RHICmdList.Transition(FRHITransitionInfo(Accumulator->GlobalVisibleCountArrayBuffer, ERHIAccess::CopySrc, ERHIAccess::SRVCompute));
+	Accumulator->VisibleCountReadbackProxies = NumProxies;
+	Accumulator->bVisibleCountReadbackPending = true;
+}
