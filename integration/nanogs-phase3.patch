+	const bool bMotionBlur = View.Family && View.Family->EngineShowFlags.MotionBlur
+		&& View.FinalPostProcessSettings.MotionBlurAmount > 0.0f
+		&& (!CVarMotionBlurQuality || CVarMotionBlurQuality->GetInt() > 0);
+
+	FGaussianSplatRasterMode Mode;
+	const int32 Velocity = CVarGSSplatVelocity.GetValueOnRenderThread();
+	Mode.bWriteVelocity = bHasVelocityTarget && (Velocity < 0 ? (bTemporalAA || bMotionBlur) : Velocity != 0);
