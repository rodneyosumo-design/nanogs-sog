+// The pixel shader's falloff: alpha = opacity * (exp(-4 r^2) - e^-4) / (1 - e^-4), r = |LocalPos| (1 at the quad edge)
+#define SPLAT_EXP_NEG4 0.018315638888734
+
+// Quad size, as a fraction of the full 2*sqrt(2) sigma extent, beyond which the pixel shader's alpha is below
+// 1/255 for this opacity (and every pixel would be discarded): the smallest quad that draws the same pixels.
+float SplatQuadScale(float opacity)
+{
+	const float minWeight = SPLAT_EXP_NEG4 + (1.0 - SPLAT_EXP_NEG4) / (255.0 * max(opacity, 1e-6));
+	return sqrt(saturate(-0.25 * log(minWeight)));
+}
