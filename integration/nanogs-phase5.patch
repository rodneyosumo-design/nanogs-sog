 #include "GaussianClusterBuilder.h"
 
+namespace
+{
+	/**
+	 * Rotation matrix of a quaternion (x, y, z, w) in column-vector convention, R[row][col]: the formula of QuatToMatrix
+	 * in GaussianDataTypes.ush, so R diag(s^2) R^T is the covariance the renderer draws for a splat.
+	 */
+	void QuatToMatrix(const FQuat4f& Q, double R[3][3])
+	{
+		const double Len = FMath::Sqrt(double(Q.X) * Q.X + double(Q.Y) * Q.Y + double(Q.Z) * Q.Z + double(Q.W) * Q.W);
+		const double Inv = Len > 0.0 ? 1.0 / Len : 0.0;
+		const double X = Q.X * Inv, Y = Q.Y * Inv, Z = Q.Z * Inv, W = Len > 0.0 ? Q.W * Inv : 1.0;
+		R[0][0] = 1.0 - 2.0 * (Y * Y + Z * Z); R[0][1] = 2.0 * (X * Y - W * Z);       R[0][2] = 2.0 * (X * Z + W * Y);
+		R[1][0] = 2.0 * (X * Y + W * Z);       R[1][1] = 1.0 - 2.0 * (X * X + Z * Z); R[1][2] = 2.0 * (Y * Z - W * X);
+		R[2][0] = 2.0 * (X * Z - W * Y);       R[2][1] = 2.0 * (Y * Z + W * X);       R[2][2] = 1.0 - 2.0 * (X * X + Y * Y);
+	}
+
+	/** Quaternion (x, y, z, w) of a rotation matrix (det +1); the inverse of QuatToMatrix (Shepperd's method). */
+	FQuat4f MatrixToQuat(const double R[3][3])
+	{
+		double X, Y, Z, W;
+		const double Trace = R[0][0] + R[1][1] + R[2][2];
+		if (Trace > 0.0)
+		{
+			const double S = 2.0 * FMath::Sqrt(Trace + 1.0); // 4w
+			W = 0.25 * S;
+			X = (R[2][1] - R[1][2]) / S;
+			Y = (R[0][2] - R[2][0]) / S;
+			Z = (R[1][0] - R[0][1]) / S;
+		}
+		else if (R[0][0] > R[1][1] && R[0][0] > R[2][2])
+		{
+			const double S = 2.0 * FMath::Sqrt(1.0 + R[0][0] - R[1][1] - R[2][2]); // 4x
+			W = (R[2][1] - R[1][2]) / S;
+			X = 0.25 * S;
+			Y = (R[0][1] + R[1][0]) / S;
+			Z = (R[0][2] + R[2][0]) / S;
+		}
+		else if (R[1][1] > R[2][2])
+		{
+			const double S = 2.0 * FMath::Sqrt(1.0 + R[1][1] - R[0][0] - R[2][2]); // 4y
+			W = (R[0][2] - R[2][0]) / S;
+			X = (R[0][1] + R[1][0]) / S;
+			Y = 0.25 * S;
+			Z = (R[1][2] + R[2][1]) / S;
+		}
+		else
+		{
+			const double S = 2.0 * FMath::Sqrt(1.0 + R[2][2] - R[0][0] - R[1][1]); // 4z
+			W = (R[1][0] - R[0][1]) / S;
+			X = (R[0][2] + R[2][0]) / S;
+			Y = (R[1][2] + R[2][1]) / S;
+			Z = 0.25 * S;
+		}
+		const double Inv = 1.0 / FMath::Sqrt(X * X + Y * Y + Z * Z + W * W);
+		return FQuat4f(float(X * Inv), float(Y * Inv), float(Z * Inv), float(W * Inv));
+	}
+
+	/**
+	 * Eigen-decomposition of a symmetric 3x3 matrix by cyclic Jacobi rotations: A = V diag(Eigen) V^T with the
+	 * eigenvectors in V's columns. V is returned as a rotation (det +1).
+	 */
+	void EigenSymmetric3(const double InA[3][3], double Eigen[3], double V[3][3])
+	{
+		double A[3][3];
+		for (int32 Row = 0; Row < 3; ++Row)
+		{
+			for (int32 Col = 0; Col < 3; ++Col)
+			{
+				A[Row][Col] = InA[Row][Col];
+				V[Row][Col] = Row == Col ? 1.0 : 0.0;
+			}
+		}
+		static constexpr int32 Pairs[3][2] = { { 0, 1 }, { 0, 2 }, { 1, 2 } };
+		for (int32 Sweep = 0; Sweep < 32; ++Sweep)
+		{
+			const double Off = A[0][1] * A[0][1] + A[0][2] * A[0][2] + A[1][2] * A[1][2];
+			const double Diag = A[0][0] * A[0][0] + A[1][1] * A[1][1] + A[2][2] * A[2][2];
+			if (Off <= 1e-24 * Diag)
+			{
+				break;
+			}
+			for (const int32* Pair : Pairs)
+			{
+				const int32 P = Pair[0], Q = Pair[1];
+				if (A[P][Q] == 0.0)
+				{
+					continue;
+				}
+				// Rotation J (identity except J[P][P] = J[Q][Q] = C, J[P][Q] = S, J[Q][P] = -S) that zeroes A[P][Q]:
+				// A <- J^T A J, V <- V J
+				const double Theta = (A[Q][Q] - A[P][P]) / (2.0 * A[P][Q]);
+				const double T = (Theta >= 0.0 ? 1.0 : -1.0) / (FMath::Abs(Theta) + FMath::Sqrt(Theta * Theta + 1.0));
+				const double C = 1.0 / FMath::Sqrt(T * T + 1.0);
+				const double S = T * C;
+				for (int32 K = 0; K < 3; ++K)
+				{
+					const double AKP = A[K][P], AKQ = A[K][Q];
+					A[K][P] = C * AKP - S * AKQ;
+					A[K][Q] = S * AKP + C * AKQ;
+				}
+				for (int32 K = 0; K < 3; ++K)
+				{
+					const double APK = A[P][K], AQK = A[Q][K];
+					A[P][K] = C * APK - S * AQK;
+					A[Q][K] = S * APK + C * AQK;
+				}
+				for (int32 K = 0; K < 3; ++K)
+				{
+					const double VKP = V[K][P], VKQ = V[K][Q];
+					V[K][P] = C * VKP - S * VKQ;
+					V[K][Q] = S * VKP + C * VKQ;
+				}
+			}
+		}
+		for (int32 K = 0; K < 3; ++K)
+		{
+			Eigen[K] = A[K][K];
+		}
+		const double Det = V[0][0] * (V[1][1] * V[2][2] - V[1][2] * V[2][1])
+			- V[0][1] * (V[1][0] * V[2][2] - V[1][2] * V[2][0])
+			+ V[0][2] * (V[1][0] * V[2][1] - V[1][1] * V[2][0]);
+		if (Det < 0.0)
+		{
+			for (int32 K = 0; K < 3; ++K)
+			{
+				V[K][2] = -V[K][2];
+			}
+		}
+	}
+
+	/** Covariance R diag(s^2) R^T of a splat, in its asset's local space (cm^2). */
+	void SplatCovariance(const FGaussianSplatData& Splat, double Out[3][3])
+	{
+		double R[3][3];
+		QuatToMatrix(Splat.Rotation, R);
+		const double S2[3] = { double(Splat.Scale.X) * Splat.Scale.X, double(Splat.Scale.Y) * Splat.Scale.Y, double(Splat.Scale.Z) * Splat.Scale.Z };
+		for (int32 Row = 0; Row < 3; ++Row)
+		{
+			for (int32 Col = 0; Col < 3; ++Col)
+			{
+				Out[Row][Col] = R[Row][0] * S2[0] * R[Col][0] + R[Row][1] * S2[1] * R[Col][1] + R[Row][2] * S2[2] * R[Col][2];
+			}
+		}
+	}
+
+	/** A splat's largest cross-section, the product of its two largest axes (area / pi, cm^2). */
+	double Footprint(const FVector3f& Scale)
+	{
+		const double A = FMath::Abs(Scale.X), B = FMath::Abs(Scale.Y), C = FMath::Abs(Scale.Z);
+		return FMath::Max3(A * B, A * C, B * C);
+	}
+}
