diff -ruN a/Plugins/NanoGS/Source/NanoGSEditor/Private/Tests/ClusterLODMergeTests.cpp b/Plugins/NanoGS/Source/NanoGSEditor/Private/Tests/ClusterLODMergeTests.cpp
--- a/Plugins/NanoGS/Source/NanoGSEditor/Private/Tests/ClusterLODMergeTests.cpp	1969-12-31 19:00:00
+++ b/Plugins/NanoGS/Source/NanoGSEditor/Private/Tests/ClusterLODMergeTests.cpp	2026-09-29 17:24:48
@@ -0,0 +1,189 @@
+// Copyright Epic Games, Inc. All Rights Reserved.
+
+// LOD merge tests: FGaussianClusterBuilder::MergeGaussians must reproduce the moment-matched Gaussian of its group,
+// with covariances built the way the renderer builds them (QuatToMatrix in GaussianDataTypes.ush).
+//   UnrealEditor SHUTourDemo.uproject -ExecCmds="Automation RunTests NanoGS.Cluster" -TestExit="Automation Test Queue Empty" -unattended -nullrhi -NoP4
+
+#include "CoreMinimal.h"
+#include "Misc/AutomationTest.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+#include "GaussianClusterBuilder.h"
+#include "Math/RandomStream.h"
+
+namespace
+{
+	struct FCov
+	{
+		double M[3][3] = {};
+	};
+
+	/** R diag(s^2) R^T with R written out as in GaussianDataTypes.ush QuatToMatrix (column-vector convention). */
+	FCov Covariance(const FGaussianSplatData& Splat)
+	{
+		const FQuat4f Q = Splat.Rotation.GetNormalized();
+		const double X = Q.X, Y = Q.Y, Z = Q.Z, W = Q.W;
+		const double R[3][3] = {
+			{ 1.0 - 2.0 * (Y * Y + Z * Z), 2.0 * (X * Y - W * Z), 2.0 * (X * Z + W * Y) },
+			{ 2.0 * (X * Y + W * Z), 1.0 - 2.0 * (X * X + Z * Z), 2.0 * (Y * Z - W * X) },
+			{ 2.0 * (X * Z - W * Y), 2.0 * (Y * Z + W * X), 1.0 - 2.0 * (X * X + Y * Y) } };
+		const double S2[3] = { FMath::Square(double(Splat.Scale.X)), FMath::Square(double(Splat.Scale.Y)), FMath::Square(double(Splat.Scale.Z)) };
+		FCov C;
+		for (int32 Row = 0; Row < 3; ++Row)
+		{
+			for (int32 Col = 0; Col < 3; ++Col)
+			{
+				C.M[Row][Col] = R[Row][0] * S2[0] * R[Col][0] + R[Row][1] * S2[1] * R[Col][1] + R[Row][2] * S2[2] * R[Col][2];
+			}
+		}
+		return C;
+	}
+
+	double RelativeError(const FCov& A, const FCov& B)
+	{
+		double Num = 0.0, Den = 0.0;
+		for (int32 Row = 0; Row < 3; ++Row)
+		{
+			for (int32 Col = 0; Col < 3; ++Col)
+			{
+				Num += FMath::Square(A.M[Row][Col] - B.M[Row][Col]);
+				Den += FMath::Square(B.M[Row][Col]);
+			}
+		}
+		return FMath::Sqrt(Num / FMath::Max(Den, 1e-300));
+	}
+
+	double Footprint(const FVector3f& S)
+	{
+		return FMath::Max3(double(S.X) * S.Y, double(S.X) * S.Z, double(S.Y) * S.Z);
+	}
+
+	float Uniform(FRandomStream& Rng, float Min, float Max)
+	{
+		return Min + (Max - Min) * Rng.GetFraction();
+	}
+
+	FGaussianSplatData RandomSplat(FRandomStream& Rng, const FVector3f& Centre, float Spread)
+	{
+		FGaussianSplatData S;
+		S.Position = Centre + FVector3f(Uniform(Rng, -Spread, Spread), Uniform(Rng, -Spread, Spread), Uniform(Rng, -Spread, Spread));
+		S.Rotation = FQuat4f(Uniform(Rng, -1, 1), Uniform(Rng, -1, 1), Uniform(Rng, -1, 1), Uniform(Rng, -1, 1)).GetNormalized();
+		// Log-uniform scales from 0.01 to 10 cm: flat, needle-like and round splats
+		S.Scale = FVector3f(FMath::Pow(10.0f, Uniform(Rng, -2, 1)), FMath::Pow(10.0f, Uniform(Rng, -2, 1)), FMath::Pow(10.0f, Uniform(Rng, -2, 1)));
+		S.Opacity = Uniform(Rng, 0.02f, 1.0f);
+		S.SH_DC = FVector3f(Uniform(Rng, -2, 2), Uniform(Rng, -2, 2), Uniform(Rng, -2, 2));
+		return S;
+	}
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FNanoGSClusterMomentMatchedMergeTest, "NanoGS.Cluster.MomentMatchedMerge",
+	EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FNanoGSClusterMomentMatchedMergeTest::RunTest(const FString& Parameters)
+{
+	FRandomStream Rng(20260929);
+
+	// One splat merges into itself: covariance, centre, colour and opacity survive the eigen-decomposition and the
+	// conversion back to a quaternion for any rotation and scale.
+	double SingleCov = 0.0, SingleOther = 0.0;
+	for (int32 Iter = 0; Iter < 2000; ++Iter)
+	{
+		const TArray<FGaussianSplatData> One = { RandomSplat(Rng, FVector3f(100, -50, 20), 10) };
+		const FGaussianSplatData M = FGaussianClusterBuilder::MergeGaussians(One, 0, 1);
+		SingleCov = FMath::Max(SingleCov, RelativeError(Covariance(M), Covariance(One[0])));
+		SingleOther = FMath::Max3(SingleOther, double((M.Position - One[0].Position).GetAbsMax()), double((M.SH_DC - One[0].SH_DC).GetAbsMax()));
+		SingleOther = FMath::Max(SingleOther, double(FMath::Abs(M.Opacity - One[0].Opacity)));
+	}
+	TestTrue(FString::Printf(TEXT("A single splat keeps its covariance (max relative error %.3g)"), SingleCov), SingleCov <= 1e-5);
+	TestTrue(FString::Printf(TEXT("A single splat keeps its centre, colour and opacity (max error %.3g)"), SingleOther), SingleOther <= 1e-4);
+
+	// Groups of four: mean and covariance are the moments of the group, weighted by opacity x footprint; opacity is
+	// 1 - prod(1 - a_i), capped so that opacity x footprint doesn't exceed the children's sum.
+	double GroupCov = 0.0, GroupMean = 0.0, GroupOpacity = 0.0;
+	for (int32 Iter = 0; Iter < 2000; ++Iter)
+	{
+		const float Spread = FMath::Pow(10.0f, Uniform(Rng, -1, 2));
+		TArray<FGaussianSplatData> Group;
+		for (int32 I = 0; I < 4; ++I)
+		{
+			Group.Add(RandomSplat(Rng, FVector3f(-300, 20, 500), Spread));
+		}
+		const FGaussianSplatData M = FGaussianClusterBuilder::MergeGaussians(Group, 0, Group.Num());
+
+		double Weights[4], Sum = 0.0, Transparency = 1.0;
+		for (int32 I = 0; I < 4; ++I)
+		{
+			Weights[I] = Group[I].Opacity * Footprint(Group[I].Scale);
+			Sum += Weights[I];
+			Transparency *= 1.0 - Group[I].Opacity;
+		}
+		FVector3d Mean(0.0);
+		for (int32 I = 0; I < 4; ++I)
+		{
+			Mean += Weights[I] / Sum * FVector3d(Group[I].Position);
+		}
+		FCov Want;
+		for (int32 I = 0; I < 4; ++I)
+		{
+			const FCov C = Covariance(Group[I]);
+			const FVector3d D = FVector3d(Group[I].Position) - Mean;
+			for (int32 Row = 0; Row < 3; ++Row)
+			{
+				for (int32 Col = 0; Col < 3; ++Col)
+				{
+					Want.M[Row][Col] += Weights[I] / Sum * (C.M[Row][Col] + D[Row] * D[Col]);
+				}
+			}
+		}
+		const double WantOpacity = FMath::Min(1.0 - Transparency, Sum / Footprint(M.Scale));
+		GroupCov = FMath::Max(GroupCov, RelativeError(Covariance(M), Want));
+		GroupMean = FMath::Max(GroupMean, (FVector3d(M.Position) - Mean).GetAbsMax());
+		GroupOpacity = FMath::Max(GroupOpacity, FMath::Abs(double(M.Opacity) - WantOpacity));
+	}
+	TestTrue(FString::Printf(TEXT("Merged covariance is the group's second moment (max relative error %.3g)"), GroupCov), GroupCov <= 1e-5);
+	TestTrue(FString::Printf(TEXT("Merged centre is the weighted mean (max error %.3g cm)"), GroupMean), GroupMean <= 1e-3);
+	TestTrue(FString::Printf(TEXT("Merged opacity is capped by coverage (max error %.3g)"), GroupOpacity), GroupOpacity <= 1e-5);
+
+	// Four flat splats tiling a tilted wall 2 sigma apart: the merged splat lies in the wall, stays as thin as its
+	// children and spreads over both of them (variance 4^2 + 4^2 per in-plane axis); side by side, its opacity is
+	// set by coverage (4 x 0.3 x 16 / 32 = 0.6), not by stacking (1 - 0.7^4 = 0.76).
+	{
+		const FQuat4f Wall = FQuat4f(FVector3f(0.3f, -0.8f, 0.5f).GetSafeNormal(), 0.7f);
+		const FVector3f U = Wall.RotateVector(FVector3f(1, 0, 0)), V = Wall.RotateVector(FVector3f(0, 1, 0)), N = Wall.RotateVector(FVector3f(0, 0, 1));
+		TArray<FGaussianSplatData> Tiles;
+		for (int32 I = 0; I < 4; ++I)
+		{
+			FGaussianSplatData S;
+			S.Position = FVector3f(50, 60, 70) + U * ((I & 1) ? 4.0f : -4.0f) + V * ((I & 2) ? 4.0f : -4.0f);
+			S.Rotation = Wall;
+			S.Scale = FVector3f(4.0f, 4.0f, 0.05f);
+			S.Opacity = 0.3f;
+			Tiles.Add(S);
+		}
+		const FGaussianSplatData M = FGaussianClusterBuilder::MergeGaussians(Tiles, 0, Tiles.Num());
+		// The thinnest merged axis is the wall normal
+		const FVector3f Axes[3] = { M.Rotation.RotateVector(FVector3f(1, 0, 0)), M.Rotation.RotateVector(FVector3f(0, 1, 0)), M.Rotation.RotateVector(FVector3f(0, 0, 1)) };
+		const int32 Thin = M.Scale.X <= M.Scale.Y ? (M.Scale.X <= M.Scale.Z ? 0 : 2) : (M.Scale.Y <= M.Scale.Z ? 1 : 2);
+		TestTrue(TEXT("Merged wall splat is oriented along the wall"), FMath::Abs(Axes[Thin] | N) >= 0.9999f);
+		TestTrue(TEXT("Merged wall splat stays as thin as its children"), FMath::IsNearlyEqual(M.Scale[Thin], 0.05f, 1e-4f));
+		TestTrue(TEXT("Merged wall splat spans its children"), FMath::IsNearlyEqual(M.Scale[(Thin + 1) % 3], FMath::Sqrt(32.0f), 1e-3f)
+			&& FMath::IsNearlyEqual(M.Scale[(Thin + 2) % 3], FMath::Sqrt(32.0f), 1e-3f));
+		TestTrue(FString::Printf(TEXT("Side-by-side children keep their coverage (opacity %.4f)"), M.Opacity), FMath::IsNearlyEqual(M.Opacity, 0.6f, 1e-4f));
+	}
+
+	// Stacked copies of one splat: same Gaussian, opacity 1 - prod(1 - a_i)
+	{
+		const TArray<FGaussianSplatData> Stack = { RandomSplat(Rng, FVector3f(0), 0), RandomSplat(Rng, FVector3f(0), 0) };
+		TArray<FGaussianSplatData> Copies = { Stack[0], Stack[0], Stack[0] };
+		Copies[1].Opacity = 0.5f;
+		Copies[2].Opacity = 0.25f;
+		const FGaussianSplatData M = FGaussianClusterBuilder::MergeGaussians(Copies, 0, Copies.Num());
+		const double Stacked = 1.0 - (1.0 - Copies[0].Opacity) * 0.5 * 0.75;
+		TestTrue(TEXT("Stacked copies keep the covariance"), RelativeError(Covariance(M), Covariance(Copies[0])) <= 1e-5);
+		TestTrue(FString::Printf(TEXT("Stacked copies combine opacity as 1 - prod(1 - a) (%.4f vs %.4f)"), M.Opacity, Stacked), FMath::IsNearlyEqual(double(M.Opacity), Stacked, 1e-5));
+	}
+	return true;
+}
