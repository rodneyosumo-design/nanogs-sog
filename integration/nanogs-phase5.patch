+		/** Largest cross-section of a splat: the product of its two largest axes. */
+		double Footprint(const FVector3f& Scale)
+		{
+			return FMath::Max3(double(Scale.X) * Scale.Y, double(Scale.X) * Scale.Z, double(Scale.Y) * Scale.Z);
