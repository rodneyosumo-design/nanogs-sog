+// Copyright Epic Games, Inc. All Rights Reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "GaussianDataTypes.h"
+#include "SOG/SOGCodec.h"
+#include "SOG/SOGTypes.h"
+
+/**
+ * SOG (PlayCanvas "Spatially Ordered Gaussians") support shared by the runtime and editor modules.
+ * The file reader (zip, JSON, WebP) lives in NanoGSEditor and installs itself here, so the runtime
+ * module never links the WebP decoder.
+ */
+namespace GaussianSplatSOG
+{
+	using FReader = TFunction<bool(const FString& Path, sog::DecodedAsset& Out, FString& OutError)>;
+
+	/** Installed by NanoGSEditor at startup; cleared on shutdown. */
+	NANOGS_API void SetReader(FReader InReader);
+
+	/** True for .sog bundles and unbundled SOG folders addressed by their meta.json. */
+	NANOGS_API bool IsSOGPath(const FString& Path);
+
+	/** Read a SOG asset through the installed reader. Fails when NanoGSEditor isn't loaded. */
+	NANOGS_API bool Read(const FString& Path, sog::DecodedAsset& Out, FString& OutError);
+
+	/**
+	 * Decode every record to NanoGS's CPU splat format in Unreal local space, with the same
+	 * conversion as FPLYFileReader: centimetres, (x, y, z) -> (z, x, -y), quaternion
+	 * (w, x, y, z) -> (w, -z, -x, y), scale axes (z, x, y), linear scale and opacity.
+	 */
+	NANOGS_API void ToSplatData(const sog::DecodedAsset& Asset, TArray<FGaussianSplatData>& OutSplats);
+
+	/** Inverse of ToSplatData for one splat: Unreal local space back to the SOG file frame. */
+	NANOGS_API void FromSplatData(const FGaussianSplatData& In, sog::SplatFloat& Out);
+
+	/**
+	 * GPU records for a Nanite-built asset: the first NumBase records are the source records in the
+	 * cluster builder's order (Order[i] = source index of splat i), the rest are NanoGS's merged LOD
+	 * splats quantized with the source's ranges and codebooks and flagged as having no SH.
+	 */
+	NANOGS_API void BuildRecords(const sog::DecodedAsset& Asset, const TArray<int32>& Order,
+		const TArray<FGaussianSplatData>& Splats, int32 NumBase, TArray<sog::PackedSplat>& OutRecords);
+}
