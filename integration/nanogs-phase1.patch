+// Copyright Epic Games, Inc. All Rights Reserved.
+
+#include "GaussianSplatSOGReader.h"
+#include "SOGLoader.h"
+#include "Misc/FileHelper.h"
+#include "Misc/Paths.h"
+
+namespace
+{
+	FString ToFString(const std::string& Text)
+	{
+		return FString(UTF8_TO_TCHAR(Text.c_str()));
+	}
+
+	/** Unbundled SOG: sibling files of meta.json, read through Unreal's file system. */
+	class FFolderSource final : public sog::FileSource
+	{
+	public:
+		explicit FFolderSource(FString InDirectory) : Directory(MoveTemp(InDirectory)) {}
+
+		virtual bool Read(const std::string& Name, std::vector<uint8_t>& Out, std::string* Error) override
+		{
+			const FString Relative = ToFString(Name);
+			if (Relative.Contains(TEXT("..")) || !FPaths::IsRelative(Relative))
+			{
+				if (Error) { *Error = "refusing path " + Name; }
+				return false;
+			}
+			TArray<uint8> Bytes;
+			if (!FFileHelper::LoadFileToArray(Bytes, *FPaths::Combine(Directory, Relative)))
+			{
+				if (Error) { *Error = "missing " + Name; }
+				return false;
+			}
+			Out.assign(Bytes.GetData(), Bytes.GetData() + Bytes.Num());
+			return true;
+		}
+
+	private:
+		FString Directory;
+	};
+}
+
+bool NanoGSReadSOG(const FString& Path, sog::DecodedAsset& Out, FString& OutError)
+{
+	std::unique_ptr<sog::FileSource> Source;
+	std::string Error;
+	if (FPaths::GetCleanFilename(Path).Equals(TEXT("meta.json"), ESearchCase::IgnoreCase))
+	{
+		Source = std::make_unique<FFolderSource>(FPaths::GetPath(Path));
+	}
+	else
+	{
+		TArray<uint8> Bytes;
+		if (!FFileHelper::LoadFileToArray(Bytes, *Path))
+		{
+			OutError = FString::Printf(TEXT("Cannot read %s"), *Path);
+			return false;
+		}
+		Source = sog::MakeZipSource(std::vector<uint8_t>(Bytes.GetData(), Bytes.GetData() + Bytes.Num()), &Error);
+		if (!Source)
+		{
+			OutError = FString::Printf(TEXT("%s is not a valid .sog bundle: %s"), *Path, *ToFString(Error));
+			return false;
+		}
+	}
+
+	const sog::Error Result = sog::LoadSOG(*Source, Out, &Error);
+	if (Result != sog::Error::Ok)
+	{
+		OutError = FString::Printf(TEXT("%s: %s (%s)"), *Path, *ToFString(Error), *ToFString(sog::ErrorName(Result)));
+		return false;
+	}
+	return true;
+}
