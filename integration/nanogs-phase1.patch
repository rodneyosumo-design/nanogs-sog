+void UGaussianSplatAsset::GetSOGRecordData(TArray<uint8>& OutData)
+{
+	const int64 DataSize = SOGRecordBulkData.GetBulkDataSize();
+	if (DataSize > 0)
+	{
+		OutData.SetNumUninitialized(static_cast<int32>(DataSize));
+		void* Dest = OutData.GetData();
+		SOGRecordBulkData.GetCopy(&Dest, /*bDiscardInternalCopy*/ true);
+	}
+	else
+	{
+		OutData.Empty();
+	}
+}
+
+void UGaussianSplatAsset::GetSOGPaletteData(TArray<uint8>& OutData)
+{
+	const int64 DataSize = SOGPaletteBulkData.GetBulkDataSize();
+	if (DataSize > 0)
+	{
+		OutData.SetNumUninitialized(static_cast<int32>(DataSize));
+		void* Dest = OutData.GetData();
+		SOGPaletteBulkData.GetCopy(&Dest, /*bDiscardInternalCopy*/ true);
+	}
+	else
+	{
+		OutData.Empty();
+	}
+}
+
 #if WITH_EDITOR
+namespace
+{
+	void WriteBulkData(FByteBulkData& Bulk, const void* Data, int64 Bytes)
+	{
+		Bulk.Lock(LOCK_READ_WRITE);
+		void* Dest = Bulk.Realloc(Bytes);
+		if (Bytes > 0)
+		{
+			FMemory::Memcpy(Dest, Data, Bytes);
+		}
+		Bulk.Unlock();
+		Bulk.SetBulkDataFlags(BULKDATA_Force_NOT_InlinePayload);
+	}
+}
+
+void UGaussianSplatAsset::SetSOGData(const sog::DecodedAsset& Source, const TArray<sog::PackedSplat>& Records)
+{
+	check(Records.Num() == SplatCount);
+	SOGConstants = sog::MakeConstants(Source, sog::kNanoGSFileToLocal);
+	SOGConstants.count = uint32(Records.Num());
+	SOGScaleLUT = TArray<float>(Source.scaleLUT, 256);
+	SOGDCLUT = TArray<float>(Source.dcLUT, 256);
+	WriteBulkData(SOGRecordBulkData, Records.GetData(), int64(Records.Num()) * int64(sizeof(sog::PackedSplat)));
+	WriteBulkData(SOGPaletteBulkData, Source.paletteHalf4.data(), int64(Source.paletteHalf4.size()) * int64(sizeof(uint16)));
+	bHasSOGData = true;
+	SOGSHBands = int32(Source.shBands);
+	SOGPaletteCount = int32(Source.paletteCount);
+}
+
+void UGaussianSplatAsset::ClearSOGData()
+{
+	bHasSOGData = false;
+	SOGSHBands = 0;
+	SOGPaletteCount = 0;
+	SOGConstants = sog::AssetConstants{};
+	SOGScaleLUT.Empty();
+	SOGDCLUT.Empty();
+	SOGRecordBulkData.RemoveBulkData();
+	SOGPaletteBulkData.RemoveBulkData();
+}
+
+bool UGaussianSplatAsset::ReadSourceSplats(TArray<FGaussianSplatData>& OutSplats, sog::DecodedAsset& OutSOG,
+	bool& bOutIsSOG, FString& OutError) const
+{
+	bOutIsSOG = GaussianSplatSOG::IsSOGPath(SourceFilePath);
+	if (bOutIsSOG)
+	{
+		if (!GaussianSplatSOG::Read(SourceFilePath, OutSOG, OutError))
+		{
+			return false;
+		}
+		GaussianSplatSOG::ToSplatData(OutSOG, OutSplats);
+		return true;
+	}
+	return FPLYFileReader::ReadPLYFile(SourceFilePath, OutSplats, OutError);
+}
