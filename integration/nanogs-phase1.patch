+// Copyright Epic Games, Inc. All Rights Reserved.
+
+#include "GaussianSplatSOG.h"
+#include "Async/ParallelFor.h"
+
+namespace GaussianSplatSOG
+{
+	namespace
+	{
+		FReader GReader;
+		constexpr float MetersToUE = 100.0f;
+	}
+
+	void SetReader(FReader InReader)
+	{
+		GReader = MoveTemp(InReader);
+	}
+
+	bool IsSOGPath(const FString& Path)
+	{
+		return FPaths::GetExtension(Path).Equals(TEXT("sog"), ESearchCase::IgnoreCase)
+			|| FPaths::GetCleanFilename(Path).Equals(TEXT("meta.json"), ESearchCase::IgnoreCase);
+	}
+
+	bool Read(const FString& Path, sog::DecodedAsset& Out, FString& OutError)
+	{
+		if (!GReader)
+		{
+			OutError = TEXT("SOG reader not available (the NanoGSEditor module isn't loaded)");
+			return false;
+		}
+		return GReader(Path, Out, OutError);
+	}
+
+	void ToSplatData(const sog::DecodedAsset& Asset, TArray<FGaussianSplatData>& OutSplats)
+	{
+		OutSplats.SetNum(int32(Asset.count));
+		ParallelFor(int32(Asset.count), [&Asset, &OutSplats](int32 Index)
+		{
+			sog::SplatFloat S;
+			sog::DecodeSplat(Asset, size_t(Index), S);
+			FGaussianSplatData& D = OutSplats[Index];
+			D.Position = FVector3f(S.position[2] * MetersToUE, S.position[0] * MetersToUE, -S.position[1] * MetersToUE);
+			D.Rotation = GaussianSplattingUtils::NormalizeQuat(FQuat4f(-S.rotation[3], -S.rotation[1], S.rotation[2], S.rotation[0]));
+			D.Scale = FVector3f(S.scale[2] * MetersToUE, S.scale[0] * MetersToUE, S.scale[1] * MetersToUE);
+			D.Opacity = S.opacity;
+			D.SH_DC = FVector3f(S.dc[0], S.dc[1], S.dc[2]);
+			for (int32 C = 0; C < 15; ++C)
+			{
+				D.SH[C] = C < int32(S.shCoeffs) ? FVector3f(S.sh[C][0], S.sh[C][1], S.sh[C][2]) : FVector3f::ZeroVector;
+			}
+		});
+	}
+
+	void FromSplatData(const FGaussianSplatData& In, sog::SplatFloat& Out)
+	{
+		Out.position[0] = In.Position.Y / MetersToUE;
+		Out.position[1] = -In.Position.Z / MetersToUE;
+		Out.position[2] = In.Position.X / MetersToUE;
+		Out.rotation[0] = In.Rotation.W;
+		Out.rotation[1] = -In.Rotation.Y;
+		Out.rotation[2] = In.Rotation.Z;
+		Out.rotation[3] = -In.Rotation.X;
+		Out.scale[0] = In.Scale.Y / MetersToUE;
+		Out.scale[1] = In.Scale.Z / MetersToUE;
+		Out.scale[2] = In.Scale.X / MetersToUE;
+		Out.opacity = In.Opacity;
+		Out.dc[0] = In.SH_DC.X;
+		Out.dc[1] = In.SH_DC.Y;
+		Out.dc[2] = In.SH_DC.Z;
+		Out.shCoeffs = 0;
+	}
+
+	void BuildRecords(const sog::DecodedAsset& Asset, const TArray<int32>& Order,
+		const TArray<FGaussianSplatData>& Splats, int32 NumBase, TArray<sog::PackedSplat>& OutRecords)
+	{
+		check(NumBase <= Splats.Num() && NumBase <= int32(Asset.splats.size()));
+		check(Order.IsEmpty() || Order.Num() == NumBase);
+		OutRecords.SetNumUninitialized(Splats.Num());
+		for (int32 Index = 0; Index < NumBase; ++Index)
+		{
+			OutRecords[Index] = Asset.splats[size_t(Order.IsEmpty() ? Index : Order[Index])];
+		}
+		const sog::Encoder Encoder(Asset);
+		ParallelFor(Splats.Num() - NumBase, [&](int32 Offset)
+		{
+			const int32 Index = NumBase + Offset;
+			sog::SplatFloat S;
+			FromSplatData(Splats[Index], S);
+			OutRecords[Index] = Encoder.Encode(S, 0, uint8(sog::kFlagNoSH));
+		});
+	}
+}
