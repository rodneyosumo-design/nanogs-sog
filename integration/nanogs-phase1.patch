+
+UGaussianSplatAsset* UGaussianSplatAssetFactory::ImportFile(
+	const FString& FilePath,
+	UObject* InParent,
+	FName InName,
+	EObjectFlags Flags,
+	UGaussianSplatAsset* ExistingAsset)
+{
+	return GaussianSplatSOG::IsSOGPath(FilePath)
+		? ImportSOGFile(FilePath, InParent, InName, Flags, ExistingAsset)
+		: ImportPLYFile(FilePath, InParent, InName, Flags, ExistingAsset);
+}
+
+UGaussianSplatAsset* UGaussianSplatAssetFactory::ImportSOGFile(
+	const FString& FilePath,
+	UObject* InParent,
+	FName InName,
+	EObjectFlags Flags,
+	UGaussianSplatAsset* ExistingAsset)
+{
+	FScopedSlowTask SlowTask(100.0f, FText::FromString(TEXT("Importing SOG Gaussian Splat...")));
+	SlowTask.MakeDialog(true);
+
+	SlowTask.EnterProgressFrame(30.0f, FText::FromString(TEXT("Reading SOG file...")));
+	sog::DecodedAsset Decoded;
+	FString ErrorMessage;
+	if (!GaussianSplatSOG::Read(FilePath, Decoded, ErrorMessage))
+	{
+		UE_LOG(LogTemp, Error, TEXT("Failed to read SOG file: %s"), *ErrorMessage);
+		return nullptr;
+	}
+
+	TArray<FGaussianSplatData> SplatData;
+	GaussianSplatSOG::ToSplatData(Decoded, SplatData);
+	UE_LOG(LogTemp, Log, TEXT("Read %d splats from SOG file (SH bands: %d, palette: %d)"),
+		SplatData.Num(), int32(Decoded.shBands), int32(Decoded.paletteCount));
+
+	SlowTask.EnterProgressFrame(10.0f, FText::FromString(TEXT("Creating asset...")));
+	UGaussianSplatAsset* Asset = ExistingAsset;
+	if (!Asset)
+	{
+		Asset = NewObject<UGaussianSplatAsset>(InParent, UGaussianSplatAsset::StaticClass(), InName, Flags);
+	}
+	if (!Asset)
+	{
+		UE_LOG(LogTemp, Error, TEXT("Failed to create Gaussian Splat asset"));
+		return nullptr;
+	}
+
+	Asset->SourceFilePath = FilePath;
+	Asset->SHBands = int32(Decoded.shBands);
+
+	// The legacy buffers keep the asset renderable by the current pipeline; the SOG records carry the
+	// same splats in the same order for the GPU decode path.
+	SlowTask.EnterProgressFrame(55.0f, FText::FromString(TEXT("Compressing splat data...")));
+	Asset->InitializeFromSplatData(SplatData, QualityLevel);
+	Asset->ClusterHierarchy.Reset();
+	Asset->SetSOGData(Decoded, TArray<sog::PackedSplat>(Decoded.splats.data(), int32(Decoded.splats.size())));
+
+	Asset->MarkPackageDirty();
+
+	UE_LOG(LogTemp, Log, TEXT("Successfully imported SOG Gaussian Splat asset: %d splats, %lld bytes (SOG records %lld, palette %lld)"),
+		Asset->GetSplatCount(), Asset->GetMemoryUsage(), Asset->GetSOGRecordDataSize(), Asset->GetSOGPaletteDataSize());
+
+	return Asset;
+}
