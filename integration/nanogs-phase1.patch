+		FString Text;
+		return FPaths::GetCleanFilename(Filename).Equals(TEXT("meta.json"), ESearchCase::IgnoreCase)
+			&& FFileHelper::LoadFileToString(Text, *Filename)
+			&& Text.Contains(TEXT("\"means\"")) && Text.Contains(TEXT("\"quats\"")) && Text.Contains(TEXT("\"sh0\""));
+	}
 	return Extension.Equals(TEXT("ply"), ESearchCase::IgnoreCase) && FPLYFileReader::IsValidPLYFile(Filename);
 }
 
