+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FNanoGSSOGLegacyAssetLoadsTest, "NanoGS.SOG.LegacyAssetStillLoads",
+	EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FNanoGSSOGLegacyAssetLoadsTest::RunTest(const FString& Parameters)
+{
+	const FString Legacy = TEXT("/Game/Gaussian/scene_nosky.scene_nosky");
+	if (!FPackageName::DoesPackageExist(FPackageName::ObjectPathToPackageName(Legacy)))
+	{
+		AddInfo(TEXT("scene_nosky not in this project; skipping"));
+		return true;
+	}
+	UGaussianSplatAsset* Asset = LoadObject<UGaussianSplatAsset>(nullptr, *Legacy);
+	if (!TestNotNull(TEXT("Version 5 asset loads"), Asset))
+	{
+		return false;
+	}
+	AddInfo(FString::Printf(TEXT("scene_nosky: %d splats, %d clusters"), Asset->GetSplatCount(), Asset->GetClusterCount()));
+	TestTrue(TEXT("Legacy asset has splats"), Asset->GetSplatCount() > 0);
+	TestFalse(TEXT("Legacy asset has no SOG data"), Asset->HasSOGData());
+	return true;
+}
