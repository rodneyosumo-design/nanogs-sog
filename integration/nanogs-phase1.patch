+// Copyright Epic Games, Inc. All Rights Reserved.
+
+// SOG import tests. They need the nanogs-sog repository's Phase 0 data; set NANOGS_SOG_TESTDATA to its
+// data/ folder (scene_nosky.sog, scene_nosky_roundtrip.ply, blueprint_test/*.bin). Without it they skip.
+//   UnrealEditor SHUTourDemo.uproject -ExecCmds="Automation RunTests NanoGS.SOG" -TestExit="Automation Test Queue Empty" -unattended -nullrhi -NoP4
+
+#include "CoreMinimal.h"
+#include "Misc/AutomationTest.h"
+
+#if WITH_DEV_AUTOMATION_TESTS
+
+#include "GaussianSplatAsset.h"
+#include "GaussianSplatAssetFactory.h"
+#include "GaussianSplatSOG.h"
+#include "PLYFileReader.h"
+#include "SOG/GaussianSplatSOGReader.h"
+#include "SOG/SOGCodec.h"
+#include "SOGJson.h"
+#include "HAL/FileManager.h"
+#include "HAL/PlatformMisc.h"
+#include "Misc/FileHelper.h"
+#include "Misc/PackageName.h"
+#include "UObject/Package.h"
+#include "UObject/SavePackage.h"
+#include "UObject/UObjectGlobals.h"
+
+namespace
+{
+	FString TestDataDir()
+	{
+		return FPlatformMisc::GetEnvironmentVariable(TEXT("NANOGS_SOG_TESTDATA"));
+	}
+
+	/** Local-space (cm) position of one record, same arithmetic as GaussianSplatSOG::ToSplatData. */
+	FVector3f DecodeLocalPosition(const sog::DecodedAsset& Ranges, const sog::PackedSplat& Record)
+	{
+		sog::DecodedAsset One;
+		for (int32 K = 0; K < 3; ++K)
+		{
+			One.meanMin[K] = Ranges.meanMin[K];
+			One.meanMax[K] = Ranges.meanMax[K];
+		}
+		One.count = 1;
+		One.splats.push_back(Record);
+		sog::SplatFloat S;
+		sog::DecodeSplat(One, 0, S);
+		return FVector3f(S.position[2] * 100.0f, S.position[0] * 100.0f, -S.position[1] * 100.0f);
+	}
+
+	bool LoadBytes(const FString& Path, TArray<uint8>& Out)
+	{
+		return FFileHelper::LoadFileToArray(Out, *Path);
+	}
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FNanoGSSOGReaderMatchesPLYTest, "NanoGS.SOG.ReaderMatchesPLYImporter",
+	EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FNanoGSSOGReaderMatchesPLYTest::RunTest(const FString& Parameters)
+{
+	const FString Dir = TestDataDir();
+	if (Dir.IsEmpty())
+	{
+		AddInfo(TEXT("NANOGS_SOG_TESTDATA not set; skipping"));
+		return true;
+	}
+
+	sog::DecodedAsset Decoded;
+	FString Error;
+	if (!TestTrue(TEXT("SOG reader loads scene_nosky.sog"), NanoGSReadSOG(Dir / TEXT("scene_nosky.sog"), Decoded, Error)))
+	{
+		AddError(Error);
+		return false;
+	}
+	TArray<FGaussianSplatData> FromSOG;
+	GaussianSplatSOG::ToSplatData(Decoded, FromSOG);
+
+	TArray<FGaussianSplatData> FromPLY;
+	if (!TestTrue(TEXT("PLY importer reads the round-trip PLY"),
+		FPLYFileReader::ReadPLYFile(Dir / TEXT("scene_nosky_roundtrip.ply"), FromPLY, Error)))
+	{
+		AddError(Error);
+		return false;
+	}
+	if (!TestEqual(TEXT("Splat counts"), FromSOG.Num(), FromPLY.Num()))
+	{
+		return false;
+	}
+
+	double Pos = 0, Rot = 0, Scale = 0, Opacity = 0, DC = 0, SH = 0;
+	for (int32 I = 0; I < FromSOG.Num(); ++I)
+	{
+		const FGaussianSplatData& A = FromSOG[I];
+		const FGaussianSplatData& B = FromPLY[I];
+		Pos = FMath::Max(Pos, double((A.Position - B.Position).GetAbsMax()));
+		Rot = FMath::Max(Rot, 1.0 - FMath::Abs(double(A.Rotation | B.Rotation)));
+		Scale = FMath::Max(Scale, double(((A.Scale - B.Scale) / B.Scale).GetAbsMax()));
+		Opacity = FMath::Max(Opacity, double(FMath::Abs(A.Opacity - B.Opacity)));
+		DC = FMath::Max(DC, double((A.SH_DC - B.SH_DC).GetAbsMax()));
+		for (int32 C = 0; C < 15; ++C)
+		{
+			SH = FMath::Max(SH, double((A.SH[C] - B.SH[C]).GetAbsMax()));
+		}
+	}
+	AddInfo(FString::Printf(TEXT("%d splats; max differences: position %.3g cm, rotation 1-|dot| %.3g, scale %.3g rel, opacity %.3g, DC %.3g, SH %.3g"),
+		FromSOG.Num(), Pos, Rot, Scale, Opacity, DC, SH));
+	TestTrue(TEXT("Positions match"), Pos <= 1e-3);
+	TestTrue(TEXT("Rotations match"), Rot <= 1e-6);
+	TestTrue(TEXT("Scales match"), Scale <= 1e-5);
+	TestTrue(TEXT("Opacities match"), Opacity <= 1e-6);
+	TestTrue(TEXT("DC colours match exactly"), DC == 0.0);
+	TestTrue(TEXT("SH coefficients match exactly"), SH == 0.0);
+	return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FNanoGSSOGImportNaniteSaveTest, "NanoGS.SOG.ImportNaniteSaveReload",
+	EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FNanoGSSOGImportNaniteSaveTest::RunTest(const FString& Parameters)
+{
+	const FString Dir = TestDataDir();
+	if (Dir.IsEmpty())
+	{
+		AddInfo(TEXT("NANOGS_SOG_TESTDATA not set; skipping"));
+		return true;
+	}
+	const FString SourcePath = Dir / TEXT("scene_nosky.sog");
+	const FString PackageName = TEXT("/Game/NanoGS_SOGTest_Temp/SOGTest");
+	const FString PackageFile = FPackageName::LongPackageNameToFilename(PackageName, FPackageName::GetAssetPackageExtension());
+
+	// Import
+	UPackage* Package = CreatePackage(*PackageName);
+	UGaussianSplatAssetFactory* Factory = NewObject<UGaussianSplatAssetFactory>();
+	bool bCanceled = false;
+	UGaussianSplatAsset* Asset = Cast<UGaussianSplatAsset>(Factory->FactoryCreateFile(UGaussianSplatAsset::StaticClass(),
+		Package, TEXT("SOGTest"), RF_Public | RF_Standalone, SourcePath, nullptr, GWarn, bCanceled));
+	if (!TestNotNull(TEXT("Factory imports the .sog"), Asset))
+	{
+		return false;
+	}
+	TestTrue(TEXT("Asset carries SOG data"), Asset->HasSOGData());
+	TestEqual(TEXT("SOG SH bands"), Asset->SOGSHBands, 3);
+	TestEqual(TEXT("SOG palette entries"), Asset->SOGPaletteCount, 65536);
+
+	TArray<uint8> Records, RefRecords, Palette, RefPalette;
+	Asset->GetSOGRecordData(Records);
+	Asset->GetSOGPaletteData(Palette);
+	TestTrue(TEXT("Records identical to the Phase 0 reference"),
+		LoadBytes(Dir / TEXT("blueprint_test/records.bin"), RefRecords) && Records == RefRecords);
+	TestTrue(TEXT("Half-float palette identical to the Phase 0 reference"),
+		LoadBytes(Dir / TEXT("blueprint_test/palette_half4.bin"), RefPalette) && Palette == RefPalette);
+	TestEqual(TEXT("Lookup tables"), Asset->GetSOGScaleLUT().Num() + Asset->GetSOGDCLUT().Num(), 512);
+
+	// Nanite build: records must stay aligned with the legacy buffers, splat for splat
+	if (!TestTrue(TEXT("Nanite build succeeds"), Asset->BuildNaniteClusterHierarchy()))
+	{
+		return false;
+	}
+	const int32 Total = Asset->GetSplatCount();
+	const int32 Base = Asset->GetOriginalSplatCount();
+	Asset->GetSOGRecordData(Records);
+	TestEqual(TEXT("One SOG record per splat after the Nanite build"), Records.Num(), Total * int32(sizeof(sog::PackedSplat)));
+	TestEqual(TEXT("SOG constants count"), int32(Asset->GetSOGConstants().count), Total);
+
+	sog::DecodedAsset Ranges;
+	FString Error;
+	NanoGSReadSOG(SourcePath, Ranges, Error);
+	const sog::PackedSplat* Packed = reinterpret_cast<const sog::PackedSplat*>(Records.GetData());
+	const TArray<FVector> Legacy = Asset->GetDecompressedPositions();
+	double BaseErr = 0.0, LodErr = 0.0;
+	int32 LodNoSH = 0;
+	for (int32 I = 0; I < Total && I < Legacy.Num(); ++I)
+	{
+		const double Err = (FVector(DecodeLocalPosition(Ranges, Packed[I])) - Legacy[I]).GetAbsMax();
+		if (I < Base)
+		{
+			BaseErr = FMath::Max(BaseErr, Err);
+		}
+		else
+		{
+			LodErr = FMath::Max(LodErr, Err);
+			LodNoSH += ((Packed[I].dc >> 24) & sog::kFlagNoSH) ? 1 : 0;
+		}
+	}
+	AddInfo(FString::Printf(TEXT("Nanite: %d base + %d LOD splats, %d clusters; position vs legacy buffer: base %.3g cm, LOD %.3g cm"),
+		Base, Total - Base, Asset->GetClusterCount(), BaseErr, LodErr));
+	TestTrue(TEXT("Base splats follow the builder's reordering exactly"), BaseErr <= 1e-3);
+	TestTrue(TEXT("LOD splats quantize within 0.1 cm"), LodErr <= 0.1);
+	TestEqual(TEXT("Every LOD splat is flagged as having no SH"), LodNoSH, Total - Base);
+
+	// Save (version 6) and reload from disk
+	FSavePackageArgs SaveArgs;
+	SaveArgs.TopLevelFlags = RF_Public | RF_Standalone;
+	SaveArgs.SaveFlags = SAVE_NoError;
+	const bool bSaved = UPackage::SavePackage(Package, Asset, *PackageFile, SaveArgs);
+	TestTrue(TEXT("Package saves"), bSaved);
+
+	const TArray<uint8> RecordsBefore = Records;
+	const int32 ClustersBefore = Asset->GetClusterCount();
+	// Move the in-memory package aside so LoadPackage reads the saved file instead of returning it
+	Package->Rename(*FString::Printf(TEXT("/Temp/NanoGS_SOGTest_Old_%s"), *FGuid::NewGuid().ToString()),
+		nullptr, REN_DontCreateRedirectors | REN_NonTransactional);
+	UPackage* Reloaded = bSaved ? LoadPackage(nullptr, *PackageName, LOAD_None) : nullptr;
+	UGaussianSplatAsset* ReloadedAsset = Reloaded ? FindObject<UGaussianSplatAsset>(Reloaded, TEXT("SOGTest")) : nullptr;
+	if (TestNotNull(TEXT("Saved asset reloads"), ReloadedAsset))
+	{
+		TArray<uint8> ReloadedRecords, ReloadedPalette;
+		ReloadedAsset->GetSOGRecordData(ReloadedRecords);
+		ReloadedAsset->GetSOGPaletteData(ReloadedPalette);
+		TestTrue(TEXT("Reloaded asset keeps its SOG data"), ReloadedAsset->HasSOGData());
+		TestTrue(TEXT("Reloaded records identical"), ReloadedRecords == RecordsBefore);
+		TestTrue(TEXT("Reloaded palette identical"), ReloadedPalette == Palette);
+		TestEqual(TEXT("Reloaded splat count"), ReloadedAsset->GetSplatCount(), Total);
+		TestEqual(TEXT("Reloaded cluster count"), ReloadedAsset->GetClusterCount(), ClustersBefore);
+		TestTrue(TEXT("Reloaded constants identical"),
+			FMemory::Memcmp(&ReloadedAsset->GetSOGConstants(), &Asset->GetSOGConstants(), sizeof(sog::AssetConstants)) == 0);
+		ReloadedAsset->ClearFlags(RF_Public | RF_Standalone);
+		ReloadedAsset->MarkAsGarbage();
+		ResetLoaders(Reloaded);
+	}
+	Asset->ClearFlags(RF_Public | RF_Standalone);
+	Asset->MarkAsGarbage();
+
+	IFileManager::Get().Delete(*PackageFile, false, true, true);
+	IFileManager::Get().DeleteDirectory(*FPaths::GetPath(PackageFile), false, false);
+	CollectGarbage(GARBAGE_COLLECTION_KEEPFLAGS);
+	return true;
+}
