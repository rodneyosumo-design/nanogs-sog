+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FNanoGSSOGFixturesTest, "NanoGS.SOG.Fixtures",
+	EAutomationTestFlags::EditorContext | EAutomationTestFlags::ProductFilter)
+
+bool FNanoGSSOGFixturesTest::RunTest(const FString& Parameters)
+{
+	// Fixtures from tools/phase1/make_fixtures.py: valid bundles/folders and one file per error path.
+	const FString Dir = TestDataDir() / TEXT("fixtures");
+	FString ManifestText;
+	if (TestDataDir().IsEmpty() || !FFileHelper::LoadFileToString(ManifestText, *(Dir / TEXT("fixtures.json"))))
+	{
+		AddInfo(TEXT("fixtures not available; skipping"));
+		return true;
+	}
+	const FTCHARToUTF8 Utf8(*ManifestText);
+	sog::json::Value Manifest;
+	std::string ParseError;
+	if (!TestTrue(TEXT("fixtures.json parses"), sog::json::Parse(Utf8.Get(), size_t(Utf8.Length()), Manifest, &ParseError)))
+	{
+		return false;
+	}
+
+	int32 Checked = 0;
+	for (const auto& Item : Manifest.object)
+	{
+		const FString Name = UTF8_TO_TCHAR(Item.first.c_str());
+		const FString Expected = UTF8_TO_TCHAR(Item.second.Find("error")->string.c_str());
+		FString Path = Dir / FString(UTF8_TO_TCHAR(Item.second.Find("path")->string.c_str()));
+		if (FPaths::DirectoryExists(Path))
+		{
+			Path = Path / TEXT("meta.json");
+		}
+		sog::DecodedAsset Decoded;
+		FString Error;
+		const bool bLoaded = NanoGSReadSOG(Path, Decoded, Error);
+		if (Expected == TEXT("Ok"))
+		{
+			const sog::json::Value* Records = Item.second.Find("records");
+			bool bSame = bLoaded && Records && Records->array.size() == Decoded.splats.size();
+			for (size_t I = 0; bSame && I < Decoded.splats.size(); ++I)
+			{
+				const uint32* Got = &Decoded.splats[I].meanXY;
+				for (size_t K = 0; K < 5; ++K)
+				{
+					bSame = bSame && uint32(Records->array[I].array[K].number) == Got[K];
+				}
+			}
+			TestTrue(FString::Printf(TEXT("%s loads with the expected records"), *Name), bSame);
+		}
+		else
+		{
+			const bool bRightError = !bLoaded && (Error.Contains(FString::Printf(TEXT("(%s)"), *Expected))
+				|| (Expected == TEXT("NotZipOrFolder") && Error.Contains(TEXT("not a valid .sog bundle"))));
+			TestTrue(FString::Printf(TEXT("%s fails with %s (%s)"), *Name, *Expected, *Error), bRightError);
+		}
+		++Checked;
+	}
+	AddInfo(FString::Printf(TEXT("%d fixtures checked"), Checked));
+
+	// The factory also imports an unbundled folder through its meta.json
+	UGaussianSplatAssetFactory* Factory = NewObject<UGaussianSplatAssetFactory>();
+	const FString MetaPath = Dir / TEXT("valid_folder/meta.json");
+	TestTrue(TEXT("Factory accepts a SOG meta.json"), Factory->FactoryCanImport(MetaPath));
+	TestFalse(TEXT("Factory rejects other JSON"), Factory->FactoryCanImport(Dir / TEXT("fixtures.json")));
+	bool bCanceled = false;
+	UGaussianSplatAsset* Asset = Cast<UGaussianSplatAsset>(Factory->FactoryCreateFile(UGaussianSplatAsset::StaticClass(),
+		GetTransientPackage(), TEXT("SOGFolderTest"), RF_Transient, MetaPath, nullptr, GWarn, bCanceled));
+	if (TestNotNull(TEXT("Folder imports"), Asset))
+	{
+		TestEqual(TEXT("Folder asset splat count"), Asset->GetSplatCount(), 100);
+		TestTrue(TEXT("Folder asset carries SOG data"), Asset->HasSOGData());
+		Asset->MarkAsGarbage();
+	}
+	return true;
+}
